// realtime.hml -- a server-stepped match on top of the session
//
// The session (seat, ready, start, relay) is unchanged; this runs from the session's start to its
// end. The game supplies the rules as hooks and this owns everything else: the clock, each seat's
// latest intent, snapshots, and the end. Design: Ganbatte engine docs/ganbatte/REALTIME.md.
//
// Hooks (opts.realtime), all called on the server's event loop:
//   new_match(seed, seats)        -> the match state. seats: [{ slot, name, human, data }], one per
//                                 base; data is what the seat sent as GBE_SEAT_DATA, or ""
//   new_match_with(seed, seats, settings)  optional, used instead of new_match when given: the
//                                 same, with the lobby's settings the host set before the start,
//                                 { teams, mode } (GAME_TEAMS; a roster of n seats starts with
//                                 n, every seat its own side; GAME_MODE, 0 until the host sets
//                                 one, whose meaning is the game's)
//   intent(match, slot, values)   a seat's intent for the step about to run (one a tick, below)
//   step(match)                   one tick
//   snapshot(match, slot)         -> an array of gn values for that seat (usually one buffer)
//   over(match)                   -> whether the match has ended, checked after each tick
//   fingerprint(match)            -> a string every client is checked against
//   sent(match)                   optional: after each round of snapshots (clear events here)
//   leave(match, slot)            optional: a seat's connection went away mid-match
//
// ONE INTENT A TICK. A client sends one intent for each of its ticks and predicts its own entity
// one tick per intent, so the server consumes them the same way: each seat's intents queue on
// arrival and every step takes the oldest. Applying only the latest on arrival (as v0.2.1 did)
// loses one whenever jitter lands two inside a tick, and the client's prediction then runs a
// whole tick ahead of the server and is corrected (about 12 px for a biplane at full speed). An
// empty queue keeps the seat's last intent; a queue past intent_buffer (default 4) drops its
// oldest, so a client whose clock runs fast cannot build up latency. The acknowledgement in each
// snapshot is the last intent a step consumed, not the last received.
//
// AND HOW MANY ARE STILL WAITING. A client and the server both tick at tick_hz, so a backlog
// never drains by itself: every time jitter lands two intents in one tick the queue gains one
// and keeps it, a tick of input latency each, until intent_buffer (measured: two waiting on a
// LAN, three in a five-minute match over the internet, 120 ms acknowledged). Each snapshot
// therefore carries the seat's queue depth after the step, and the client runs its own clock a
// few percent slow while intents are waiting (and a little fast while the queue runs dry), so
// the queue drains with nothing dropped: the engine's gbe_realtime.
//
// The clock is gn's Server.every(), so a tick runs on the same thread as packet handlers and
// nothing here is locked. If the loop falls behind it catches up at most max_catchup ticks a
// period and drops the rest: the match runs slow rather than in bursts.

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "../src/id.hml";
import { roundi } from "@stdlib/math";

// Is u16 sequence a newer than b? Sequences wrap at 65536; b of -1 means none yet.
export fn seq_newer(a, b) {
    if (b < 0) { return true; }
    let d = (a - b + 65536) % 65536;
    return d != 0 && d < 32768;
}

export fn Realtime(server, game, cm, hooks, opts) {
    let tick_hz = 30;
    let send_hz = 20;
    let max_catchup = 5;
    let intent_buffer = 4;
    if (opts != null) {
        if (opts?.intent_buffer != null) { intent_buffer = opts.intent_buffer; }
        if (opts?.tick_hz != null) { tick_hz = opts.tick_hz; }
        if (opts?.send_hz != null) { send_hz = opts.send_hz; }
        if (opts?.max_catchup != null) { max_catchup = opts.max_catchup; }
    }

    let rt = {
        hooks: hooks,
        tick_hz: tick_hz,
        send_hz: send_hz,
        max_catchup: max_catchup,
        intent_buffer: intent_buffer,
        state: null,
        running: false,
        tick: 0,
        timer: null,
        seats: 0,
        acked: [],        // per slot: the last intent sequence a step consumed, -1 for none
        received: [],     // per slot: the last sequence queued, so a stale or repeated one is ignored
        queue: [],        // per slot: [{ seq, values }] waiting for a step, oldest first
        overflow: 0,      // intents dropped because a seat's queue was full
        qsum: [],         // per slot: the queue's depth summed over the steps that took from it
        qn: [],           // per slot: those steps
        qmax: [],         // per slot: the deepest it was
        empty: [],        // per slot: steps that found its queue empty (the last intent reused)
        send_acc: 0,      // send_hz accumulated per tick; a round goes out each time it passes tick_hz
        dropped: 0,       // ticks not stepped because the loop fell too far behind
        fingerprint: "",

        start: fn() {
            if (self.running) { return; }
            let seats = [];
            let i = 0;
            while (i < game.num_bases) {
                let p = game.get_player(i);
                let name = "";
                let human = false;
                let data = "";
                if (p != null) {
                    name = p.name;
                    human = p.connection != null;
                    if (p?.seat_data != null) { data = p.seat_data; }
                }
                seats.push({ slot: i, name: name, human: human, data: data });
                i = i + 1;
            }
            self.seats = seats.length;
            self.acked = [];
            self.received = [];
            self.queue = [];
            self.overflow = 0;
            self.qsum = [];
            self.qn = [];
            self.qmax = [];
            self.empty = [];
            i = 0;
            while (i < self.seats) {
                self.acked.push(-1);
                self.received.push(-1);
                self.queue.push([]);
                self.qsum.push(0);
                self.qn.push(0);
                self.qmax.push(0);
                self.empty.push(0);
                i = i + 1;
            }
            if (self.hooks?.new_match_with != null) {
                self.state = self.hooks.new_match_with(game.seed, seats, { teams: game.num_teams, mode: game.game_mode });
            } else {
                self.state = self.hooks.new_match(game.seed, seats);
            }
            self.tick = 0;
            self.send_acc = 0;
            self.dropped = 0;
            self.fingerprint = "";
            self.running = true;

            i = 0;
            while (i < cm.connections.length) {
                let c = cm.connections[i];
                if (c != null) {
                    let p = Packet(id.GBE_RT_START);
                    p.add(game.seed);
                    p.add(self.tick_hz);
                    p.add(self.send_hz);
                    p.add(self.tick);
                    p.add(i);
                    p.add(self.seats);
                    c.send(p);
                }
                i = i + 1;
            }

            let me = self;
            self.timer = server.every(1000 / self.tick_hz, fn(periods, srv) {
                me.on_timer(periods);
            });
            print("realtime: match started, " + self.seats + " seats, " + self.tick_hz + " Hz ticks, " + self.send_hz + " Hz snapshots");
        },

        intent: fn(slot, packet) {
            if (!self.running || slot == null || slot >= self.seats) { return; }
            let seq = packet.get(0);
            if (seq == null || !seq_newer(seq, self.received[slot])) { return; }
            self.received[slot] = seq;
            let values = [];
            let i = 2;
            while (i < packet.data.length) {
                values.push(packet.data[i]);
                i = i + 1;
            }
            let q = self.queue[slot];
            q.push({ seq: seq, values: values });
            if (q.length > self.intent_buffer) {
                q.shift();
                self.overflow = self.overflow + 1;
            }
        },

        // Before each step: every seat's oldest queued intent.
        take_intents: fn() {
            let slot = 0;
            while (slot < self.seats) {
                let q = self.queue[slot];
                if (q.length > 0) {
                    self.qsum[slot] = self.qsum[slot] + q.length;
                    self.qn[slot] = self.qn[slot] + 1;
                    if (q.length > self.qmax[slot]) { self.qmax[slot] = q.length; }
                    let e = q.shift();
                    self.acked[slot] = e.seq;
                    self.hooks.intent(self.state, slot, e.values);
                } else if (self.received[slot] >= 0) {
                    self.empty[slot] = self.empty[slot] + 1;
                }
                slot = slot + 1;
            }
        },

        leave: fn(slot) {
            if (!self.running || slot >= self.seats) { return; }
            if (self.hooks?.leave != null) { self.hooks.leave(self.state, slot); }
        },

        on_timer: fn(periods) {
            if (!self.running) { return; }
            let steps = periods;
            if (steps > self.max_catchup) {
                self.dropped = self.dropped + steps - self.max_catchup;
                steps = self.max_catchup;
            }
            let k = 0;
            while (k < steps && self.running) {
                self.take_intents();
                self.hooks.step(self.state);
                self.tick = self.tick + 1;
                if (self.hooks.over(self.state)) {
                    self.finish();
                    return;
                }
                self.send_acc = self.send_acc + self.send_hz;
                if (self.send_acc >= self.tick_hz) {
                    self.send_acc = self.send_acc - self.tick_hz;
                    self.send_round(0);
                }
                k = k + 1;
            }
        },

        send_round: fn(over) {
            let i = 0;
            while (i < cm.connections.length) {
                let c = cm.connections[i];
                if (c != null) {
                    let ack = -1;
                    let queued = 0;
                    if (i < self.seats) {
                        ack = self.acked[i];
                        queued = self.queue[i].length;
                    }
                    let p = Packet(id.GBE_RT_SNAPSHOT);
                    p.add(self.tick);
                    p.add(ack);
                    p.add(over);
                    p.add(self.fingerprint);
                    p.add(queued);
                    p.add(self.hooks.snapshot(self.state, i));
                    c.send(p);
                }
                i = i + 1;
            }
            if (self.hooks?.sent != null) { self.hooks.sent(self.state); }
        },

        // The match decided it is over: a last snapshot to everyone, carrying the fingerprint.
        // The session stays started until the host ends it, as for any other game.
        finish: fn() {
            self.fingerprint = self.hooks.fingerprint(self.state);
            self.send_round(1);
            self.stop();
            print("realtime: match over at tick " + self.tick + " (" + self.dropped + " ticks dropped, " + self.overflow + " intents over the buffer), fingerprint " + self.fingerprint);
            // Each sending seat's intent queue: how many waited, on average, when a step took one.
            // Every intent waiting is a tick of latency the player's input carries.
            let slot = 0;
            while (slot < self.seats) {
                if (self.qn[slot] > 0 || self.empty[slot] > 0) {
                    let avg = 0.0;
                    if (self.qn[slot] > 0) { avg = self.qsum[slot] / self.qn[slot]; }
                    print("realtime: seat " + slot + " intent queue " + roundi(avg * 100.0) / 100.0 + " deep on average, " + self.qmax[slot]
                        + " at most; " + self.empty[slot] + " steps found it empty");
                }
                slot = slot + 1;
            }
        },

        stop: fn() {
            if (self.timer != null) {
                server.cancel(self.timer);
                self.timer = null;
            }
            self.running = false;
        },
    };
    return rt;
}
