// session.hml — Connection lifecycle management
//
// Manages player connections, heartbeat tracking, reconnection by UID,
// and server auto-shutdown timers. Generic across games.

import { Packet } from "Yotis-Studios/gn.hml";
import { send_event } from "./lobby.hml";
import { sleep } from "@stdlib/time";
import { time_ms } from "@stdlib/time";

// Heartbeat timeout in milliseconds
let HEARTBEAT_TIMEOUT = 60000;
// Max server lifetime in milliseconds (24 hours)
let MAX_LIFETIME = 86400000;
// Host connect timeout in milliseconds
let HOST_CONNECT_TIMEOUT = 60000;

let INITIAL_SLOTS = 10;

export fn Session(server, kick_packet_id) {
    // Pre-allocate slot arrays
    let init_connections = [];
    let init_heartbeats = [];
    let init_uids = [];
    let s = 0;
    while (s < INITIAL_SLOTS) {
        init_connections.push(null);
        init_heartbeats.push(null);
        init_uids.push(null);
        s = s + 1;
    }

    let session = {
        server: server,
        connections: init_connections,
        heartbeats: init_heartbeats,
        uids: init_uids,
        kick_packet_id: kick_packet_id,
        _closed: false,

        _grow_to: fn(slot) {
            while (self.connections.length <= slot) {
                self.connections.push(null);
                self.heartbeats.push(null);
                self.uids.push(null);
            }
        },

        set_connection: fn(slot, connection) {
            self._grow_to(slot);
            self.connections[slot] = connection;
            self.heartbeats[slot] = time_ms();
        },

        clear_connection: fn(slot) {
            self.connections[slot] = null;
            self.heartbeats[slot] = null;
        },

        get_connection: fn(slot) {
            if (slot >= self.connections.length) { return null; }
            return self.connections[slot];
        },

        update_heartbeat: fn(slot) {
            if (slot < self.heartbeats.length) {
                self.heartbeats[slot] = time_ms();
            }
        },

        get_slot_by_connection: fn(connection) {
            let i = 0;
            while (i < self.connections.length) {
                if (self.connections[i] == connection) {
                    return i;
                }
                i = i + 1;
            }
            return null;
        },

        find_slot_by_uid: fn(uid) {
            let i = 0;
            while (i < self.uids.length) {
                if (self.uids[i] == uid && self.connections[i] == null) {
                    return i;
                }
                i = i + 1;
            }
            return null;
        },

        set_uid: fn(slot, uid) {
            self._grow_to(slot);
            self.uids[slot] = uid;
        },

        kick: fn(connection, message) {
            let packet = Packet(self.kick_packet_id);
            packet.add(message);
            connection.send(packet);
            connection.kick();
        },

        kick_all: fn(message) {
            let packet = Packet(self.kick_packet_id);
            packet.add(message);
            let i = 0;
            while (i < self.connections.length) {
                if (self.connections[i] != null) {
                    self.connections[i].send(packet);
                }
                i = i + 1;
            }
        },

        count_connections: fn() {
            let count = 0;
            let i = 0;
            while (i < self.connections.length) {
                if (self.connections[i] != null) {
                    count = count + 1;
                }
                i = i + 1;
            }
            return count;
        },

        // Auto-shutdown watchdogs.
        //
        // ==================================================================================
        // `spawn` COPIES ITS ARGUMENTS. A CLOSURE SEES THE LIVE OBJECT.
        // ==================================================================================
        //
        // Every one of these used to take the session as a spawn ARGUMENT, and a spawned task
        // receives a deep copy — a snapshot of the session as it was at startup, when every
        // connection slot is null and every heartbeat is null. Measured, not inferred:
        //
        //     let obj = { v: 1 };
        //     spawn(async fn(o) { sleep(1.0); print(o.v); }, obj);   // prints 1
        //     spawn(async fn()  { sleep(1.0); print(obj.v); });      // prints 42
        //     obj.v = 42;
        //
        // So the host-connect watchdog was asking a frozen copy whether the host had connected,
        // and the answer was always no: EVERY LOBBY WAS KILLED SIXTY SECONDS AFTER IT STARTED,
        // with a full roster in it, mid-match. The client is told only "Server closed.", so it
        // reads as the server crashing or the network dropping.
        //
        // The heartbeat watchdog had the mirror-image failure and was harmless for it — its
        // copy's heartbeats are all null, so it never fired and dead connections were never
        // reaped. Two watchdogs, one useless and one actively hostile, from one cause.
        //
        // Nothing could see it. It needs a lobby to stay up for more than a minute, which means
        // two clients, a map upload and a started match — and the single-client test flow
        // finishes in about fifteen seconds.
        //
        // The rule for this file: a spawned task reads shared state through the CLOSURE. If you
        // find yourself passing a struct to spawn, that struct is about to stop changing.
        start_timers: fn(host_slot, on_timeout) {
            let sess = self;

            // Host connect timeout — the lobby is pointless if whoever asked for it never turns
            // up. Closure over `sess`, so this sees the connection that arrives after it starts.
            spawn(async fn() {
                sleep(HOST_CONNECT_TIMEOUT / 1000.0);
                if (sess.connections[host_slot] == null && !sess._closed) {
                    on_timeout("host_timeout");
                }
            });

            // Heartbeat check every 60s. Clients ACK every 10s; a slot that has said nothing for
            // a full minute has gone away without closing its socket.
            spawn(async fn() {
                while (!sess._closed) {
                    sleep(HEARTBEAT_TIMEOUT / 1000.0);
                    let now = time_ms();
                    let i = 0;
                    while (i < sess.heartbeats.length) {
                        if (sess.heartbeats[i] != null) {
                            if (sess.heartbeats[i] < (now - HEARTBEAT_TIMEOUT)) {
                                on_timeout("heartbeat:" + i);
                            }
                        }
                        i = i + 1;
                    }
                }
            });

            // 24 hour max lifetime.
            spawn(async fn() {
                sleep(MAX_LIFETIME / 1000.0);
                if (!sess._closed) {
                    on_timeout("max_lifetime");
                }
            });
        },

        close: fn() {
            self._closed = true;
        },
    };

    return session;
}
