// Packet ID constants — must match the GameMaker client exactly

export let MESSAGE = 0;

export let CLIENT_INIT = 1;
export let CLIENT_CONNECT = 2;
export let CLIENT_DISCONNECT = 3;
export let CLIENT_HALT = 4;
export let CLIENT_ACK = 5;
export let CLIENT_READY = 6;
export let CLIENT_UID = 7;

export let PLAYER_ADD = 10;
export let PLAYER_READY = 11;
export let PLAYER_KICK = 12;
export let PLAYER_LIST = 13;
export let PLAYER_NAME = 14;
export let PLAYER_CHAT = 15;
export let PLAYER_SWAP = 16;
export let PLAYER_HOST = 17;
export let PLAYER_CUSTOM = 18;
export let PLAYER_HAT = 19;

export let PLAYER_IS_MOVE = 20;
export let PLAYER_SET_MOVE = 21;
export let PLAYER_MOVE = 22;

export let PLAYER_IS_ATTACK = 25;
export let PLAYER_SET_ATTACK = 26;
export let PLAYER_ATTACK = 27;

export let PLAYER_CONFIRM = 30;
export let PLAYER_CANCEL = 31;
export let PLAYER_RELOAD = 32;
export let PLAYER_CARD = 33;
export let PLAYER_TIER = 34;
export let PLAYER_ENDTURN = 35;
export let PLAYER_ROLL = 36;
export let PLAYER_LUCK = 37;
export let PLAYER_SYNC = 38;
export let PLAYER_SPECTATE = 39;

export let LOBBY_PASSWORD = 40;
export let LOBBY_NAME = 41;
export let LOBBY_SPECTATORS = 42;

export let CPU_LEVEL = 50;
export let CPU_CHAR = 51;

export let ERROR_SYNC = 69;

export let MAP_UPLOAD = 80;
export let MAP_DOWNLOAD = 81;
export let MAP_HASH = 82;
export let MAP_CLIMATE = 83;

export let TILE_SELECT = 90;

export let GAME_SEED = 100;
export let GAME_START = 101;
export let GAME_END = 102;
export let GAME_SYNC = 103;
export let GAME_READY = 104;
export let GAME_BASE = 105;
export let GAME_LENGTH = 106;
export let GAME_SET_SPEED = 107;
export let GAME_TIMER = 108;
export let GAME_TEAMS = 109;
export let GAME_TIER_OPTIONS = 110;
export let GAME_ATTACK_DAMAGE = 111;
export let GAME_DECK = 112;
export let GAME_SAVE = 113;
export let GAME_ONEVONE = 114;

// 1.14. The lobby roster size. Every client used to derive this from the map, so a
// host who changed it alone disagreed with the lobby about which slots exist --
// which is why the client's stepper was offline-only.
export let GAME_NUM_PLAYERS = 115;

// 1.14. How the match is won (see MATCH_MODE client-side). Relayed rather than
// clamped -- unlike the roster size there is no map property a mode can exceed, so
// the server records it for the joiner handshake and passes it on unchanged.
export let GAME_MODE = 116;

export let DECK_RESET = 140;
export let DECK_VALUES = 141;
export let DECK_COST = 142;
export let DECK_TIER = 143;
export let DECK_WEIGHT = 144;

// Zombies mode: the shooter's chosen zombie, named by spawn ordinal (netId). Pure relay --
// the horde itself is deterministic lockstep on every client and sends nothing.
export let PLAYER_ZOMBIE_TARGET = 145;
// A rescue: the current player picks the downed teammate (slot index) back up. Pure relay,
// gated like every other in-turn action.
export let PLAYER_RESCUE = 146;
// This client HAS the current map (payload: the hash it loaded). GAME_START is deferred
// until every connection has acked the current hash -- the server end of the "entered the
// match without a map" crash, the only end a modified client cannot bypass.
export let MAP_ACK = 147;

export let COIN_SPAWN = 150;
export let COIN_GET = 151;
export let COIN_CONFIRM = 152;

// Whether a player owned the game before free-to-play. Relayed like a name rather than
// added to PLAYER_LIST, which is a flat array read at a fixed stride on the client.
export let PLAYER_VETERAN = 153;

// One client's hash of the board at a turn boundary, relayed so the others can compare it with
// their own. A desync has never had a way to report itself; this is it. Relayed unverified and
// unread by this server -- it is evidence between clients, not an instruction to anybody.
export let TURN_CHECKSUM = 154;

// Relayed verbatim to every other client, never read by the server: the Ganbatte engine's
// session message. A game with no turns has nothing for valid_player_packet to gate on.
export let GBE_RELAY = 170;

// The engine's real-time channel (lib/realtime.hml, Ganbatte docs/ganbatte/REALTIME.md). Only a
// server started with opts.realtime reads or sends them; RaifuWars never does.
//   START     server to each seat: seed, tickHz, sendHz, start tick, your slot, seat count
//   INTENT    client to server: sequence (u16, wrapping), the client's tick, the game's values
//   SNAPSHOT  server to each seat: tick, last sequence applied for you, over (0/1),
//             fingerprint ("" until over), then the game's values
export let GBE_RT_START = 171;
export let GBE_RT_INTENT = 172;
export let GBE_RT_SNAPSHOT = 173;

// The engine's seat data: client to server, a seat states a short string about itself (at most
// 256 characters) that the server keeps on its player and hands a real-time match at its start
// (new_match_with's seats[i].data). Not relayed. Biplane Battle! sends its plane's loadout.
export let GBE_SEAT_DATA = 174;
