// packet_handler.hml — Packet dispatch and validation

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";

// The two echo-amplified packets (MESSAGE, PLAYER_CHAT) get a floor under them here: a
// length cap, because one oversized packet becomes N oversized packets on the broadcast,
// and a per-connection rate window, because these are the only ids a client can make the
// server multiply for free. Dropped silently -- a spammer learning the exact limit from an
// error is a spammer with a better spammer. `connection?.` because Hemlock THROWS on
// reading a field an object does not have (see connection_manager's uid note).
fn chat_ok(connection, msg, now) {
    if (msg == null) { return false; }
    if (msg.length > 500) { return false; }
    if (connection?.chat_win == null || now - connection.chat_win > 5000) {
        connection.chat_win = now;
        connection.chat_n = 0;
    }
    connection.chat_n = connection.chat_n + 1;
    return connection.chat_n <= 10;
}
import { SaveData } from "./save_data.hml";
import { ChunkedUpload } from "./chunked.hml";
import { send_event } from "../lib/lobby.hml";
import { randint, randf } from "@stdlib/random";
import { time_ms } from "@stdlib/time";

export fn PacketHandler(connection_manager) {
    let server = connection_manager.server;
    let game = connection_manager.game;

    return {
        connection_manager: connection_manager,
        server: server,
        game: game,

        handle_packet: fn(connection, packet) {
            let g = self.game;
            let cm = self.connection_manager;
            let i = cm.get_id_from_connection(connection);
            let is_host = g.host == i;
            let is_player = i != null && i < g.num_bases;
            let cur_player_idx = g.turn % g.turn_rotation();
            let half = g.num_bases / 2;
            let is_onevone = g.onevone;
            let is_onevone_team = is_onevone && ((i < half && cur_player_idx < half) || (i >= half && cur_player_idx >= half));
            let is_cur_turn = cur_player_idx == i || is_onevone_team;
            let cur_player = g.get_player(cur_player_idx);
            let cur_player_is_cpu = cur_player.is_cpu();
            let valid_player_packet = (is_host || is_player) && (is_cur_turn || (is_host && cur_player_is_cpu));

            if (packet.net_id == id.CLIENT_ACK) {
                // A connection held at the password gate still ACKs, and its `i` is null --
                // update_heartbeat(null) indexes the heartbeat array with it, which is
                // unverified behaviour at best. An unadmitted connection has no heartbeat
                // slot to keep alive; the password prompt's own timeout owns it.
                if (i != null) { cm.session.update_heartbeat(i); }
                let ack_packet = Packet(id.CLIENT_ACK);
                ack_packet.add(time_ms() / 1000);
                connection.send(ack_packet);

            } else if (packet.net_id == id.CLIENT_UID) {
                let uid = packet.get(0);
                connection.uid = uid;
                if (i != null) {
                    g.get_player(i).uid = uid;
                } else {
                    if (g.lobby_password == "") {
                        cm.add_connection(connection);
                    }
                }

            } else if (packet.net_id == id.CLIENT_READY) {
                let ready_player = g.get_player(i);
                if (ready_player != null) {
                    let ready_packet = Packet(id.CLIENT_READY);
                    ready_packet.add(i);
                    ready_packet.add(ready_player.name);
                    self.server.broadcast(ready_packet);
                }

            } else if (packet.net_id == id.MESSAGE) {
                let message = packet.get(0);
                if (!chat_ok(connection, message, time_ms())) { return; }
                let msg_packet = Packet(id.MESSAGE);
                msg_packet.add(message);
                self.server.broadcast(msg_packet);

            } else if (packet.net_id == id.PLAYER_ADD) {
                if (i < g.num_bases || g.spectators) {
                    let player = g.get_player(i);
                    player.connection = connection;
                    player.server = self.server;
                    player.sprite = packet.get(0);
                    player.symbol = packet.get(1);
                    player.color = packet.get(2);
                    player.level = packet.get(3);
                    let pl_packet = Packet(id.PLAYER_LIST);
                    g.add_players_to_packet(pl_packet, true);
                    self.server.broadcast(pl_packet);
                }

            } else if (packet.net_id == id.PLAYER_NAME) {
                let name = packet.get(0);
                let player = g.get_player(i);
                if (player != null) {
                    player.name = name;
                }
                g.broadcast_names();

            } else if (packet.net_id == id.PLAYER_CUSTOM) {
                let j = packet.get(0);
                let player = g.get_player(j);
                // Your own slot, or the host dressing a CPU seat. The slot came from the
                // packet with no check at all -- any client could recolour anyone.
                if (player != null && (j == i || (is_host && player.is_cpu()))) {
                    player.eye_color = packet.get(1);
                    player.hair_color = packet.get(2);
                    player.uniform_color = packet.get(3);
                    player.skin_color = packet.get(4);
                    player.broadcast_custom();
                }

            } else if (packet.net_id == id.PLAYER_HAT) {
                let j = packet.get(0);
                let hat = packet.get(1);
                let player = g.get_player(j);
                // Same ownership rule as PLAYER_CUSTOM.
                if (player != null && (j == i || (is_host && player.is_cpu()))) {
                    player.hat = hat;
                    player.broadcast_hat();
                }

            } else if (packet.net_id == id.PLAYER_LIST) {
                let pl_packet = Packet(id.PLAYER_LIST);
                g.add_players_to_packet(pl_packet, true);
                self.server.broadcast(pl_packet);

            } else if (packet.net_id == id.PLAYER_ROLL) {
                if (!valid_player_packet) { return; }
                let roll = randint(1, 6);
                let luck = randf(0.0, 1.0);
                let roll_packet = Packet(id.PLAYER_ROLL);
                roll_packet.add(roll);
                roll_packet.add(luck);
                self.server.broadcast(roll_packet);

            } else if (packet.net_id == id.PLAYER_TIER) {
                if (!valid_player_packet) { return; }
                let tier_choice = packet.get(0);
                let tier_packet = Packet(id.PLAYER_TIER);
                tier_packet.add(i);
                tier_packet.add(tier_choice);
                connection.broadcast(tier_packet);
                let the_player = g.get_player(i);
                if (tier_choice == -1) { the_player.tier = the_player.tier + 1; }

            } else if (packet.net_id == id.GAME_START) {
                if (is_host) { g.start_game(); }

            } else if (packet.net_id == id.GAME_END) {
                if (is_host) { g.end_game(connection, packet); }

            } else if (packet.net_id == id.PLAYER_ENDTURN) {
                if (!valid_player_packet) { return; }
                connection.broadcast(packet);
                g.end_turn();

            } else if (packet.net_id == id.PLAYER_READY) {
                let player = g.get_player(i);
                if (player != null) {
                    if (packet.get(0) == null) {
                        player.ready = !player.ready;
                    } else {
                        player.ready = packet.get(0);
                    }
                    let ready_packet = Packet(id.PLAYER_READY);
                    ready_packet.add(i);
                    ready_packet.add(player.ready);
                    connection.broadcast(ready_packet);
                }

            } else if (packet.net_id == id.GAME_READY) {
                let player = g.get_player(i);
                if (player != null) {
                    player.ready = true;
                    if (g.all_players_ready()) {
                        let ready_packet = Packet(id.GAME_READY);
                        self.server.broadcast(ready_packet);
                    }
                }

            } else if (packet.net_id == id.PLAYER_CARD) {
                if (!valid_player_packet) { return; }
                let operation = packet.get(0);
                let card_idx = packet.get(2);
                if (operation == 2) {
                    let j = 0;
                    while (j < card_idx) {
                        packet.add(randf(0.0, 1.0));
                        j = j + 1;
                    }
                    self.server.broadcast(packet);
                } else {
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_LENGTH) {
                if (is_host) {
                    g.set_game_length(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_SET_SPEED) {
                if (is_host) {
                    g.set_game_speed(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_BASE) {
                if (is_host) {
                    g.set_random_bases(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_TIMER) {
                if (is_host) {
                    g.set_game_timer(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_ATTACK_DAMAGE) {
                if (is_host) {
                    g.set_sudden_death(packet.get(0));
                    g.set_attack_damage(packet.get(1));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_TEAMS) {
                if (is_host) {
                    g.set_num_teams(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_NUM_PLAYERS) {
                // The host asks; the SERVER decides. A client that asks for more seats than the
                // map has, or an odd count, gets the clamped value back like everybody else --
                // so the lobby cannot be pushed into a state no map can satisfy by a client that
                // is out of date, modified, or simply wrong.
                if (is_host) {
                    // set_num_players clamps and returns what it settled on -- see game.hml.
                    // The explicit choice is remembered so a later map change re-clamps it
                    // instead of resetting to the new map's capacity.
                    g.host_set_players = true;
                    let agreed = g.set_num_players(packet.get(0));

                    // REBUILT, NOT RELAYED. The value that goes out is the CLAMPED one. Relaying
                    // the incoming packet would tell the other clients what was ASKED for, and a
                    // request that hit a bound would leave the host one step ahead of the lobby --
                    // the exact disagreement this packet exists to remove.
                    let np_packet = Packet(id.GAME_NUM_PLAYERS);
                    np_packet.add(agreed);
                    self.server.broadcast(np_packet);
                }

            } else if (packet.net_id == id.GAME_ONEVONE) {
                if (is_host) {
                    g.set_one_v_one(packet.get(0));
                    connection.broadcast(packet);
                    if (g.onevone) { cm.set_one_v_one_players(); }
                }

            } else if (packet.net_id == id.GAME_MODE) {
                if (is_host) {
                    g.set_game_mode(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_TIER_OPTIONS) {
                if (is_host) {
                    g.set_tier_options(packet.get(0));
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_DECK) {
                if (is_host) {
                    let n = packet.data.length;
                    if (n == 2) {
                        g.toggle_deck_card(packet.get(0), packet.get(1));
                    } else {
                        let k = 0;
                        while (k < n) {
                            g.toggle_deck_card(k, packet.get(k));
                            k = k + 1;
                        }
                    }
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.GAME_SAVE) {
                if (is_host) {
                    if (g.game_data == null) {
                        let data_length = packet.get(0);
                        if (data_length == null || data_length <= 0 || data_length > 1000000) {
                            cm.kill_server(0);
                        } else {
                            print("Expecting " + data_length + " bytes for save data");
                            g.game_data = ChunkedUpload(data_length);
                            g.game_bytes = data_length;
                        }
                    } else {
                        let part = packet.get(0);
                        if (g.game_data.add(part)) {
                            let save_data = SaveData(g.game_data.buf);
                            save_data.inflate(fn(data) {
                                g.turn = data.turnNumber;
                                g.cur_player = data.curPlayer;
                                let pi = 0;
                                while (pi < g.players.length) {
                                    let player = g.players[pi];
                                    if (player != null) {
                                        player.ready = false;
                                        let conn = player.connection;
                                        if (conn != null) {
                                            save_data.send_data_to_connection(conn);
                                        }
                                    }
                                    pi = pi + 1;
                                }
                                // Both, so the NEXT sync reads its first packet as a length.
                                // See game.decode_map for the same pair on the map side.
                                g.game_data = null;
                                g.game_bytes = 0;
                            });
                        }
                    }
                }

            } else if (packet.net_id == id.MAP_UPLOAD) {
                if (is_host) {
                    if (g.map_data == null) {
                        // The length packet. `null` and non-positive are rejected here rather
                        // than inside ChunkedUpload so the server can kill the lobby: a client
                        // that announces a nonsense size is not one to keep talking to, and
                        // the size is the only thing standing between it and an allocation of
                        // its choosing.
                        let data_length = packet.get(0);
                        if (data_length == null || data_length <= 0 || data_length > 100000) {
                            cm.kill_server(0);
                        } else {
                            print("Expecting " + data_length + " bytes for map data");
                            g.map_data = ChunkedUpload(data_length);
                            g.map_bytes = data_length;
                        }
                    } else {
                        let part = packet.get(0);
                        if (g.map_data.add(part)) {
                            g.decode_map();
                        }
                    }
                }

            } else if (packet.net_id == id.MAP_DOWNLOAD) {
                g.map.send_data_to_connection(connection);

            } else if (packet.net_id == id.PLAYER_CHAT) {
                let team = packet.get(0);
                let chat_msg = packet.get(1);
                if (!chat_ok(connection, chat_msg, time_ms())) { return; }
                let chat_packet = Packet(id.PLAYER_CHAT);
                chat_packet.add(i);
                chat_packet.add(team);
                chat_packet.add(chat_msg);
                self.server.broadcast(chat_packet);

            } else if (packet.net_id == id.PLAYER_KICK) {
                if (is_host) {
                    let j = packet.get(0);
                    if (j != null && j >= 0 && j < cm.connections.length) {
                        let victim = cm.connections[j];
                        if (victim != null) {
                            let kick_packet = Packet(id.PLAYER_KICK);
                            kick_packet.add("You have been kicked!");
                            victim.send(kick_packet);
                            victim.kick();
                        }
                        g.init_new_player(j);
                        let pl_packet = Packet(id.PLAYER_LIST);
                        g.add_players_to_packet(pl_packet, true);
                        self.server.broadcast(pl_packet);
                    }
                }

            } else if (packet.net_id == id.PLAYER_SWAP) {
                let j = packet.get(0);
                // The client only OFFERS the swap button to the host, and to anyone for an
                // empty/CPU seat -- the server enforced none of it, so any client could yank
                // any human into any chair. This is the client's rule, written a second time;
                // the one-rulebook tension is noted in PROTOCOL.md and accepted for three
                // lines of lobby-phase gating.
                if (g.get_player(i) != null && g.get_player(j) != null
                    && (is_host || g.get_player(j).is_cpu())) {
                    let swap_packet = Packet(id.PLAYER_SWAP);
                    swap_packet.add(i);
                    swap_packet.add(j);
                    connection.broadcast(swap_packet);
                    cm.swap_connections(i, j, false);
                }

            } else if (packet.net_id == id.LOBBY_NAME) {
                if (is_host) {
                    // Stored so add_connection can replay it -- joiners never learned the
                    // lobby's name before; it went to the router event stream and nowhere else.
                    g.lobby_name = packet.get(0);
                    send_event("name", packet.get(0));
                }

            } else if (packet.net_id == id.LOBBY_PASSWORD) {
                let given_pass = packet.get(0);
                if (is_host) {
                    g.lobby_password = given_pass;
                    let locked = 0;
                    if (g.lobby_password != "") { locked = 1; }
                    send_event("locked", locked);
                } else {
                    // BRUTE-FORCE FLOOR. Each wrong guess was kicked and reconnecting is
                    // free, so retries were unlimited. Five failures arm a 30-second lockout
                    // in which every guess -- right or wrong -- is refused; the window is
                    // per-lobby rather than per-address because the transport offers no
                    // reliable address, and a shared 30s pause costs an honest mistyper
                    // little while capping a dictionary at ten guesses a minute.
                    let now = time_ms();
                    if (cm.pass_fails >= 5 && now - cm.pass_fail_at < 30000) {
                        cm.session.kick(connection, "Too many attempts. Try again shortly.");
                        return;
                    }
                    if (now - cm.pass_fail_at >= 30000) { cm.pass_fails = 0; }
                    if (g.lobby_password == given_pass) {
                        cm.pass_fails = 0;
                        cm.add_connection(connection);
                    } else {
                        cm.pass_fails = cm.pass_fails + 1;
                        cm.pass_fail_at = now;
                        cm.session.kick(connection, "Incorrect Password");
                    }
                }

            } else if (packet.net_id == id.LOBBY_SPECTATORS) {
                if (is_host) {
                    g.set_allow_spectators(packet.get(0));
                    self.server.broadcast(packet);
                }

            } else if (packet.net_id == id.PLAYER_SPECTATE) {
                if (g.spectators) {
                    cm.set_player_as_spectator(i);
                }

            } else if (packet.net_id == id.PLAYER_SYNC) {
                if (g.game_timer > 0 && is_cur_turn) {
                    let epoch_seconds = time_ms() / 1000;
                    let sync_packet = Packet(id.PLAYER_SYNC);
                    sync_packet.add(epoch_seconds);
                    sync_packet.add(epoch_seconds + g.game_timer);
                    self.server.broadcast(sync_packet);
                }

            } else if (packet.net_id == id.PLAYER_ATTACK) {
                // The ONE in-turn action that was missing this gate. Every peer's handler
                // applies PLAYER_ATTACK to the CURRENT player, so an out-of-turn sender was
                // firing somebody else's gun -- and in sudden death the server even rolled
                // the luck for it. Found by auditing every action branch against the gate.
                if (!valid_player_packet) { return; }
                if (g.sudden_death) {
                    packet.add(randf(0.0, 1.0));
                    self.server.broadcast(packet);
                } else {
                    connection.broadcast(packet);
                }

            } else if (packet.net_id == id.CPU_CHAR) {
                let cpu_char_j = packet.get(0);
                // Under 1v1 a lead may set characters for its OWN half only; is_host covers
                // everything else. The old gate let either lead redress the opposing team.
                let onevone_own_half = is_onevone && i != null
                    && ((i < half && cpu_char_j < half) || (i >= half && cpu_char_j >= half));
                if (is_host || onevone_own_half) {
                    let j = cpu_char_j;
                    let char = packet.get(1);
                    let player = g.get_player(j);
                    if (player != null) {
                        player.sprite = char;
                        let pl_packet = Packet(id.PLAYER_LIST);
                        g.add_players_to_packet(pl_packet, true);
                        self.server.broadcast(pl_packet);
                    }
                }

            } else if (packet.net_id == id.COIN_GET) {
                let tx = packet.get(0);
                let ty = packet.get(1);
                let coins = g.map.coins;
                let got_coin = false;
                let j = 0;
                while (j < coins.length) {
                    let coin = coins[j];
                    if (coin.x == tx && coin.y == ty) {
                        coins.remove(j);
                        got_coin = true;
                        break;
                    }
                    j = j + 1;
                }
                if (got_coin) {
                    let confirm_packet = Packet(id.COIN_CONFIRM);
                    confirm_packet.add(tx);
                    confirm_packet.add(ty);
                    confirm_packet.add(i);
                    self.server.broadcast(confirm_packet);
                }

            } else if (packet.net_id == id.ERROR_SYNC) {
                self.server.broadcast(packet);

            } else if (packet.net_id == id.DECK_RESET
                    || packet.net_id == id.DECK_WEIGHT
                    || packet.net_id == id.DECK_COST
                    || packet.net_id == id.DECK_TIER
                    || packet.net_id == id.DECK_VALUES) {
                g.deck.handle_deck_packet(connection, packet);

            } else if (packet.net_id == id.PLAYER_IS_MOVE
                    || packet.net_id == id.PLAYER_SET_MOVE
                    || packet.net_id == id.PLAYER_MOVE
                    || packet.net_id == id.PLAYER_IS_ATTACK
                    || packet.net_id == id.PLAYER_SET_ATTACK
                    || packet.net_id == id.PLAYER_ZOMBIE_TARGET
                    || packet.net_id == id.PLAYER_RESCUE
                    || packet.net_id == id.PLAYER_RELOAD
                    || packet.net_id == id.PLAYER_CANCEL
                    || packet.net_id == id.PLAYER_CONFIRM
                    || packet.net_id == id.TILE_SELECT) {
                if (!valid_player_packet) { return; }
                connection.broadcast(packet);
            }
        },
    };
}
