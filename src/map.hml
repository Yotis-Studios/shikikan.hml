// map.hml — Map decompression, hashing, coin spawning, data transfer

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";
import { inflate_decompress } from "@stdlib/compression";
import { sha1 } from "@stdlib/hash";
import { parse } from "@stdlib/json";
import { randint } from "@stdlib/random";
import { send_event } from "../lib/lobby.hml";

let MAX_CHUNK_SIZE = 250;

export fn Map(compressed_data, game) {
    let map = {
        data: compressed_data,
        game: game,
        coins: [],
        hash: null,
        meta: null,
    };

    // Decompress and parse map data
    let decompressed = inflate_decompress(compressed_data);

    // First line is JSON metadata; the tile grid follows it.
    //
    // A RUNE LITERAL, not a string. Indexing a Hemlock string yields a `rune`, and comparing a
    // rune to a string is always FALSE -- it warns rather than throwing, so this scan never
    // matched, ran to the end of the file, and handed the WHOLE map to the JSON parser.
    //
    // Two things made it hard to read in the log. The failure surfaced as "Unexpected trailing
    // characters in JSON" from the parser, several steps downstream of the comparison that
    // caused it; and the warning that named the real problem was emitted once per character of
    // the map -- 361 identical lines, burying everything else the server had to say.
    let newline_idx = 0;
    while (newline_idx < decompressed.length) {
        if (decompressed[newline_idx] == '\n') {
            break;
        }
        newline_idx = newline_idx + 1;
    }
    // No newline anywhere means this is not a .rwm at all. Say so here rather than letting the
    // JSON parser report it, since its message describes a symptom of this one.
    if (newline_idx >= decompressed.length) {
        throw "map data has no metadata line";
    }
    let meta_str = decompressed.slice(0, newline_idx);

    map.hash = sha1(decompressed);
    map.meta = parse(meta_str);

    map.send_data_to_connection = fn(connection) {
        let tot_len = self.data.length;

        let size_packet = Packet(id.MAP_DOWNLOAD);
        size_packet.add(tot_len);
        connection.send(size_packet);

        let i = 0;
        while (i < tot_len) {
            let n = tot_len - i;
            if (n > MAX_CHUNK_SIZE) { n = MAX_CHUNK_SIZE; }
            let chunk = self.data.slice(i, i + n);
            let chunk_packet = Packet(id.MAP_DOWNLOAD);
            chunk_packet.add(chunk);
            connection.send(chunk_packet);
            i = i + MAX_CHUNK_SIZE;
        }
    };

    map.spawn_coin = fn() {
        let tx = randint(0, self.meta.map_w - 1);
        let ty = randint(0, self.meta.map_h - 1);
        self.coins.push({ x: tx, y: ty });
        let coin_packet = Packet(id.COIN_SPAWN);
        coin_packet.add(tx);
        coin_packet.add(ty);
        self.game.server.broadcast(coin_packet);
    };

    map.get_num_bases = fn() {
        if (self.meta.bases != null) {
            return self.meta.bases.length;
        }
        return 4;
    };

    // EVERYTHING THAT RUNS AT CONSTRUCTION GOES HERE, BELOW EVERY METHOD.
    //
    // This block used to sit above them and called `map.get_num_bases()`, which does not exist
    // yet at that point: the struct literal declares the data fields and the methods are
    // assigned afterwards, one at a time. It threw "Object has no method 'get_num_bases'" --
    // and the map upload is the only thing that ever builds a Map, so nothing had run it.
    //
    // Keeping the ordering as a RULE rather than as a fix for one call: any method added below
    // is safe to use from here, and nothing here needs checking against how far down the file
    // it happens to sit.

    // Every client is told the hash so it can say whether it already has this map.
    let hash_packet = Packet(id.MAP_HASH);
    hash_packet.add(map.hash);
    game.server.broadcast(hash_packet);

    // THE SERVER OWNS THE ROSTER COUNT (PROTOCOL.md 0b). A new map re-derives it here and
    // BROADCASTS the answer -- clients no longer derive numPlayers from their own map load,
    // so an answer that never travels is a lobby that never learns it. Two rules:
    //
    //   - the host never chose a size: the map fills the roster (capacity), as ever;
    //   - the host chose one (GAME_NUM_PLAYERS): the choice survives the map change,
    //     re-clamped to the new capacity.
    //
    // num_bases is assigned BEFORE set_num_players, which clamps against it -- the old order
    // clamped against the PREVIOUS map's capacity, so a six-base map uploaded after a
    // four-base one seated four. 1v1 stays exempt: it fixes the roster itself.
    let num_bases = map.get_num_bases();
    game.num_bases = num_bases;
    if (!game.onevone) {
        let want = num_bases;
        if (game.host_set_players) { want = game.num_players; }
        let agreed = game.set_num_players(want);
        let np_packet = Packet(id.GAME_NUM_PLAYERS);
        np_packet.add(agreed);
        game.server.broadcast(np_packet);
    }

    // GameRouter lists lobbies by these.
    send_event("mapHash", map.hash);
    send_event("mapName", map.meta.name);

    return map;
}
