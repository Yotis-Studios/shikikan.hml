// map.hml — Map decompression, hashing, coin spawning, data transfer

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";
import { inflate_decompress } from "@stdlib/compression";
import { sha1 } from "@stdlib/hash";
import { parse } from "@stdlib/json";
import { randint } from "@stdlib/random";
import { send_event } from "../lib/lobby.hml";

let MAX_CHUNK_SIZE = 250;

export fn Map(compressed_data, game) {
    let map = {
        data: compressed_data,
        game: game,
        coins: [],
        hash: null,
        meta: null,
    };

    // Decompress and parse map data
    let decompressed = inflate_decompress(compressed_data);

    // First line is JSON metadata; the tile grid follows it.
    //
    // A RUNE LITERAL, not a string. Indexing a Hemlock string yields a `rune`, and comparing a
    // rune to a string is always FALSE -- it warns rather than throwing, so this scan never
    // matched, ran to the end of the file, and handed the WHOLE map to the JSON parser.
    //
    // Two things made it hard to read in the log. The failure surfaced as "Unexpected trailing
    // characters in JSON" from the parser, several steps downstream of the comparison that
    // caused it; and the warning that named the real problem was emitted once per character of
    // the map -- 361 identical lines, burying everything else the server had to say.
    let newline_idx = 0;
    while (newline_idx < decompressed.length) {
        if (decompressed[newline_idx] == '\n') {
            break;
        }
        newline_idx = newline_idx + 1;
    }
    // No newline anywhere means this is not a .rwm at all. Say so here rather than letting the
    // JSON parser report it, since its message describes a symptom of this one.
    if (newline_idx >= decompressed.length) {
        throw "map data has no metadata line";
    }
    let meta_str = decompressed.slice(0, newline_idx);

    map.hash = sha1(decompressed);
    map.meta = parse(meta_str);

    map.send_data_to_connection = fn(connection) {
        let tot_len = self.data.length;

        let size_packet = Packet(id.MAP_DOWNLOAD);
        size_packet.add(tot_len);
        connection.send(size_packet);

        let i = 0;
        while (i < tot_len) {
            let n = tot_len - i;
            if (n > MAX_CHUNK_SIZE) { n = MAX_CHUNK_SIZE; }
            let chunk = self.data.slice(i, i + n);
            let chunk_packet = Packet(id.MAP_DOWNLOAD);
            chunk_packet.add(chunk);
            connection.send(chunk_packet);
            i = i + MAX_CHUNK_SIZE;
        }
    };

    // Which tiles a coin may land on: the map's own grid, read once.
    //
    // WATER IS THE ONLY WALL in this game -- initTileAt marks every other material passable --
    // so "somewhere a raifu can reach" is very nearly "not water", and the coin picker was
    // choosing uniformly from the whole rectangle without ever looking at the grid it had
    // sitting in the same buffer as the metadata line.
    //
    // THE FORMAT, from docs/dev/MAP-FORMAT.md on the client side:
    //
    //   row     `cell,cell,cell,...` terminated by a comma, then a newline
    //   cell    `tile` or `overlay/tile` -- the value BEFORE the slash is the overlay
    //   tile    material = id % 18; a negative id is the same tile mirrored
    //   water   material 5
    //   pontoon overlay id 88 (material 16, variant 4) -- a bridge over water, and the one
    //           case where a water tile IS walkable
    //
    // WHAT THIS CANNOT KNOW, and it is most of the vegetation on the board: tile 0 is
    // climate-random, and the client scatters trees and bushes across it with perlin noise at
    // match start. None of that is in the file, so a coin can still land under a tree the
    // server never saw. Fixing that properly means the scatter being decided once and shared,
    // not a second implementation of perlin in Hemlock -- and the client-side check reports it
    // meanwhile, so the cost is visible instead of assumed.
    //
    // DELIBERATELY NOT A SECOND RULEBOOK either way: tileIsPassable's full answer needs a
    // per-instance passable flag on sixteen object types, and Krag walks on water regardless.
    // Reimplementing that here is the failure CLAUDE.md names three times over -- two
    // implementations of one rulebook, in two languages, with no shared test. What is encoded
    // below is two facts about the FILE FORMAT, which is versioned and stable, rather than two
    // rules about the game.
    // TWO TIERS, and the second is not a nicety.
    //
    //   authored  a real material with nothing on it -- GUARANTEED standable, because every
    //             material except water is passable and nothing is in the way
    //   clear     the above plus climate-random tiles, which MIGHT be standable: tile 0 is
    //             decided at match start by the client's own perlin scatter, and the trees it
    //             puts there appear nowhere in this file
    //
    // Coins prefer authored ground, which is also where they read as belonging -- on the paths
    // and terraces somebody drew rather than in the middle of procedural scrub. `clear` exists
    // because a map may have no authored terrain AT ALL: the editor starts every tile random,
    // so a custom map can be 100% tile 0, and a strict-only picker would silently stop
    // spawning coins on it.
    map.build_spawnable = fn(grid_str) {
        let authored = [];
        let clear = [];
        let rows = grid_str.split("\n");
        let y = 0;
        while (y < rows.length) {
            let row = rows[y];
            // The last row ends with a newline, so split leaves an empty string behind it.
            if (row.length > 0) {
                let cells = row.split(",");
                let x = 0;
                while (x < cells.length) {
                    let cell = cells[x];
                    // Same again per row: every cell is comma-TERMINATED, not comma-separated.
                    if (cell.length > 0) {
                        let tile_str = cell;
                        let overlay = 0;
                        let halves = cell.split("/");
                        if (halves.length == 2) {
                            overlay = number(halves[0]);
                            tile_str = halves[1];
                        }
                        let tile_v = number(tile_str);
                        // A mirrored tile is written negative; the material is the same.
                        if (tile_v < 0) { tile_v = 0 - tile_v; }
                        if (overlay < 0) { overlay = 0 - overlay; }
                        let mat_t = tile_v % 18;
                        let mat_o = overlay % 18;
                        // A pontoon is id 88 -- material 16, variant 4 -- and it is written
                        // BOTH ways: `88` alone on eleven maps, `88/5` (bridge over water) on
                        // Fjord and Ice Lake. It is the one walkable water tile, so it has to
                        // be tested before water and before objects, not after.
                        let bridged = tile_v == 88 || overlay == 88;
                        let dry = mat_t != 5;
                        // Materials 11..16 are the object set -- rubble, buildings, statues,
                        // bamboo, hay, fences, trees, barricades, walls. oObstacle's variable
                        // definition is `passable = 0` and only oBush, oCornfield and oReeds
                        // override it, so most of them block. Excluding the whole range rather
                        // than the impassable subset keeps this to one range check instead of a
                        // thirteen-id table that would have to be kept in step with
                        // getMapTileObject, and it errs the cheap way: over-excluding costs a
                        // coin on a walkable reed tile, under-excluding puts one inside a wall.
                        //
                        // BOTH SLOTS. The first version of this checked only the overlay, and a
                        // netgame promptly dropped a coin on tile id 34 -- a barricade written
                        // in the TILE slot with no overlay at all. Measured across the shipped
                        // maps afterwards: 2253 object cells in the tile slot against 705 in the
                        // overlay slot, so the half being checked was the smaller half. The
                        // client-side coin-tile check is what caught it, which is the entire
                        // argument for having built it.
                        let occupied = (mat_t >= 11 && mat_t <= 16)
                            || (overlay != 0 && mat_o >= 11 && mat_o <= 16);
                        if (bridged) { occupied = false; }
                        // A start base admits its owner and NOBODY else, so a coin on one is
                        // unreachable for every other player. Material 17 is the point set and
                        // a base is value >= 9, written as id >= 161 (17 + 18*8) -- compared as
                        // an id to keep this division-free. Ordinary capture points stay.
                        let enemy_base = mat_t == 17 && tile_v >= 161;
                        if ((dry || bridged) && !occupied && !enemy_base) {
                            clear.push({ x: x, y: y });
                            // Material 0 is climate-random: mud, snow or sand chosen at match
                            // start, with vegetation scattered over it by perlin. Always
                            // passable as GROUND, but what ends up standing on it is unknown
                            // here -- three coins in a 70-turn TrainingGrounds match landed
                            // under exactly this, every one of them on a tile 0.
                            if ((tile_v % 18) != 0) {
                                authored.push({ x: x, y: y });
                            }
                        }
                    }
                    x = x + 1;
                }
            }
            y = y + 1;
        }
        return { authored: authored, clear: clear };
    };

    map.spawn_coin = fn() {
        let tx = randint(0, self.meta.map_w - 1);
        let ty = randint(0, self.meta.map_h - 1);
        // Authored ground first, climate-random as a fallback, and the old uniform pick if the
        // parse produced nothing at all -- a coin in a lake beats a server that stops spawning
        // them. Each tier is strictly better than the one after it, so the order IS the rule.
        let pool = self.spawnable.authored;
        if (pool.length == 0) { pool = self.spawnable.clear; }
        if (pool.length > 0) {
            let pick = pool[randint(0, pool.length - 1)];
            tx = pick.x;
            ty = pick.y;
        }
        self.coins.push({ x: tx, y: ty });
        let coin_packet = Packet(id.COIN_SPAWN);
        coin_packet.add(tx);
        coin_packet.add(ty);
        self.game.server.broadcast(coin_packet);
    };

    map.get_num_bases = fn() {
        if (self.meta.bases != null) {
            return self.meta.bases.length;
        }
        return 4;
    };

    // EVERYTHING THAT RUNS AT CONSTRUCTION GOES HERE, BELOW EVERY METHOD.
    //
    // This block used to sit above them and called `map.get_num_bases()`, which does not exist
    // yet at that point: the struct literal declares the data fields and the methods are
    // assigned afterwards, one at a time. It threw "Object has no method 'get_num_bases'" --
    // and the map upload is the only thing that ever builds a Map, so nothing had run it.
    //
    // Keeping the ordering as a RULE rather than as a fix for one call: any method added below
    // is safe to use from here, and nothing here needs checking against how far down the file
    // it happens to sit.

    // The coin picker's candidate list, built once per map rather than per spawn: the grid is
    // a few hundred cells and a lobby lives for a whole match. Below the methods, per the rule
    // stated above.
    map.spawnable = map.build_spawnable(decompressed.slice(newline_idx + 1, decompressed.length));
    print("Map " + map.meta.name + ": " + map.spawnable.authored.length + " authored and "
        + map.spawnable.clear.length + " clear tiles of "
        + (map.meta.map_w * map.meta.map_h) + " can take a coin");

    // Every client is told the hash so it can say whether it already has this map.
    let hash_packet = Packet(id.MAP_HASH);
    hash_packet.add(map.hash);
    game.server.broadcast(hash_packet);

    // THE SERVER OWNS THE ROSTER COUNT (PROTOCOL.md 0b). A new map re-derives it here and
    // BROADCASTS the answer -- clients no longer derive numPlayers from their own map load,
    // so an answer that never travels is a lobby that never learns it. Two rules:
    //
    //   - the host never chose a size: the map fills the roster (capacity), as ever;
    //   - the host chose one (GAME_NUM_PLAYERS): the choice survives the map change,
    //     re-clamped to the new capacity.
    //
    // num_bases is assigned BEFORE set_num_players, which clamps against it -- the old order
    // clamped against the PREVIOUS map's capacity, so a six-base map uploaded after a
    // four-base one seated four. 1v1 stays exempt: it fixes the roster itself.
    let num_bases = map.get_num_bases();
    game.num_bases = num_bases;
    // A start pressed for the PREVIOUS map must not fire when this one's acks complete.
    game.pending_start = false;
    if (!game.onevone) {
        let want = num_bases;
        if (game.host_set_players) { want = game.num_players; }
        let agreed = game.set_num_players(want);
        let np_packet = Packet(id.GAME_NUM_PLAYERS);
        np_packet.add(agreed);
        game.server.broadcast(np_packet);
    }

    // GameRouter lists lobbies by these.
    send_event("mapHash", map.hash);
    send_event("mapName", map.meta.name);

    return map;
}
