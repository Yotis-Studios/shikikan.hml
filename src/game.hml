// game.hml — Core game state and lifecycle

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";
import { Player } from "./player.hml";
import { Map } from "./map.hml";
import { Deck } from "./deck.hml";
import { COLORS } from "./colors.hml";
import { send_event } from "../lib/lobby.hml";
import { randint, randf, shuffle } from "@stdlib/random";
import { parse, stringify } from "@stdlib/json";
import { time_ms } from "@stdlib/time";

// THE 1.15 ACTION LOG (RaifuWars docs/dev/CONCURRENCY.md, "Wire format (v1.15.0)").
//
// The server is the sequencer of one ordered log per match. A client sends ACTION_INTENT; this
// server checks it is the sender's to make (match running, this turn, the current seat, a seat
// the sender drives), stamps it with the next seq and a fresh seed, keeps it, and broadcasts it as
// ACTION to EVERYONE, the sender included -- the sender applies its own action only when this copy
// comes back. The server still knows no rules: it orders, stamps randomness and owns the clock.
//
// The legacy in-turn packets (RETIRED below) are dropped while a match runs: anything that
// changes match state goes through the log or not at all.
export let RETIRED = [
    id.PLAYER_ROLL, id.PLAYER_LUCK, id.PLAYER_MOVE, id.PLAYER_SET_MOVE, id.PLAYER_IS_MOVE,
    id.PLAYER_IS_ATTACK, id.PLAYER_SET_ATTACK, id.PLAYER_ATTACK, id.PLAYER_RELOAD,
    id.PLAYER_CANCEL, id.PLAYER_CONFIRM, id.TILE_SELECT, id.PLAYER_TIER, id.PLAYER_ENDTURN,
    id.PLAYER_CARD, id.PLAYER_RESCUE, id.PLAYER_ZOMBIE_TARGET, id.TURN_CHECKSUM,
];

// A seed is a uniform int in [0, 2^31 - 1); randint's bounds are inclusive.
let SEED_MAX = 2147483646;
// What a client may put in an intent. Bounded because the server keeps every action for the
// match and replays the log to anybody who asks.
let MAX_TYPE = 32;
let MAX_ARGS = 4096;
let MAX_CHECK = 256;

// A whole number off the wire, or null. GameMaker sends reals, so 3.0 is 3; anything else
// (a string, a bool, a fraction, nothing) is not a turn, a seat or a sequence number. integer()
// matters: an array index must be an integer and get_player(3.0) throws.
// A JSON object from a string, or null for anything else (not JSON, an array, a number).
fn parse_object(s) {
    try {
        let o = parse(s);
        if (typeof(o) == "object") { return o; }
        return null;
    } catch (e) {
        return null;
    }
}

export fn as_int(v) {
    let t = typeof(v);
    if (t == "null" || t == "string" || t == "bool" || t == "object" || t == "array") { return null; }
    if (integer(v) != v) { return null; }
    return integer(v);
}

export fn Game(server) {
    let game = {
        server: server,
        players: [null, null, null, null, null, null],
        host: 0,
        game_started: false,
        num_bases: 4,
        num_players: 4,
        // Whether the HOST ever explicitly chose a roster size (GAME_NUM_PLAYERS). Decides
        // what a new map does to the count: never chosen -> the map fills the roster
        // (capacity), chosen -> the choice survives the map change, re-clamped to the new
        // capacity. See load_map.
        host_set_players: false,
        num_teams: 4,
        onevone: false,
        turn: 0,
        cur_player: 0,
        map: null,
        // SHIKIKAN_REQUIRE_MAP=0 turns this off for games that have no map: no joiner gate, no
        // map hash to joiners, no wait for acks before start, no coins. RaifuWars keeps it on.
        requires_map: true,
        map_data: null,
        map_bytes: 0,
        game_data: null,
        game_bytes: 0,
        seed: 0,
        random_bases: false,
        bases: [0, 1, 2, 3],
        game_length: 0,
        game_mode: 0,
        game_speed: 1,
        game_timer: 120,
        sudden_death: false,
        // 0, not null. gn cannot serialise null into a packet, so a fresh lobby sending its
        // settings to a joining client threw inside connection.send and the server kicked them --
        // every first connection to a fresh server failed, which read as a network fault.
        //
        // Safe as a NUMBER because the client only reads attackDamage when suddenDeath is set
        // (fireAtAttackTarget), and sudden_death defaults false. The value is ignored until
        // somebody chooses a damage mode, at which point it is overwritten.
        attack_damage: 0,
        tier_options: 0,
        lobby_password: "",
        lobby_name: "",
        lobby_data: "",    // GBE_LOBBY_DATA: the host's settings string, the game's to read
        // A GAME_START arrived while some client had not confirmed the map -- held until the
        // last MAP_ACK lands (or the 20s watchdog gives up waiting). See packet_handler.
        pending_start: false,
        // How long that watchdog waits, in seconds. A field so a test can shorten it.
        start_watchdog_s: 20.0,
        deck: Deck(),
        spectators: true,
        last_coin: 0,
        // Called at the end of start_game and of end_game, when set. start_server points them
        // at lib/realtime.hml for a game that has a real-time match; null for RaifuWars.
        on_started: null,
        on_ended: null,

        // 1.15 action log (top of file). actions_on is RaifuWars' turn-based match; start_server
        // turns it off for a real-time game and for a session without a map (the Ganbatte
        // engine's), which have no turns to sequence.
        actions_on: true,
        seq: 0,             // the last seq handed out this match; the next action is seq + 1
        action_log: [],     // every ACTION this match, in seq order (replayed by ACTION_LOG_REQUEST)
        // The turn deadline: time_ms() at which the server ends the turn itself, 0 for none,
        // and the turn it was set for -- a deadline that outlives its turn does nothing.
        deadline_ms: 0,
        deadline_turn: -1,
        legacy_dropped: {}, // retired packet ids already logged this match, logged once each
    };

    game.reset_seed = fn() {
        self.seed = randint(0, 999999999);
    };

    game.get_player = fn(i) {
        if (i == null || i < 0 || i >= self.players.length) { return null; }
        return self.players[i];
    };

    game.swap_players = fn(i, j) {
        let temp = self.players[i];
        self.players[i] = self.players[j];
        self.players[i].client_num = i;
        self.players[j] = temp;
        self.players[j].client_num = j;

        if (self.host == i) {
            self.switch_host(j);
        } else if (self.host == j) {
            self.switch_host(i);
        }

        self.update_player_count();
    };

    game.switch_host = fn(j) {
        self.get_player(j).ready = true;
        self.host = j;
        let packet = Packet(id.PLAYER_HOST);
        packet.add(self.host);
        self.server.broadcast(packet);

        if (self.get_player(self.cur_player).is_cpu()) {
            // The old host was driving this CPU turn and its half-finished turn went with it:
            // the turn ends. 1.15 says so as an action in the log, and only in a match.
            if (self.actions_on) {
                if (self.game_started) { self.server_end("host_migration"); }
            } else {
                let endturn_packet = Packet(id.PLAYER_ENDTURN);
                self.server.broadcast(endturn_packet);
                self.end_turn();
            }
        }
    };

    game.set_random_players = fn() {
        let chosen = {};
        let i = 0;
        while (i < self.players.length) {
            let player = self.players[i];
            if (player != null && player.sprite != null) {
                chosen["" + player.sprite] = true;
            }
            i = i + 1;
        }
        i = 0;
        while (i < self.players.length) {
            let player = self.players[i];
            if (player == null) { i = i + 1; continue; }
            let is_cpu = player.is_cpu();
            if (player.sprite == null) {
                // MORE SEATS THAN CHARACTERS, the colours' bug again: drawing until a sprite is
                // free never ends once all twelve are taken, so a lobby of more than twelve
                // empty or unpicked seats hung its start (Biplane Battle!'s 16-seat lobbies,
                // October 16). Once every one is in use they are handed out again in order.
                let max_chars = 12;
                let used = 0;
                let u = 0;
                while (u < max_chars) {
                    if (chosen["" + u] == true) { used = used + 1; }
                    u = u + 1;
                }
                let sprite = 0;
                if (used >= max_chars) {
                    sprite = i % max_chars;
                } else {
                    while (chosen["" + sprite] == true) {
                        sprite = randint(0, max_chars - 1);
                    }
                }
                player.sprite = sprite;
                player.symbol = sprite;
                let half = integer(self.num_players / 2);
                if (self.onevone && player.client_num != 0 && player.client_num != half) {
                    let other_idx = 0;
                    if (player.client_num >= half) { other_idx = half; }
                    let other = self.players[other_idx];
                    player.name = other.name;
                    player.symbol = other.symbol;
                }
                if (is_cpu) {
                    player.eye_color = null;
                    player.hair_color = null;
                    player.uniform_color = null;
                    player.skin_color = null;
                    player.tip_color = null;
                    player.color_style = null;
                    player.broadcast_custom();
                    player.hat = null;
                    player.broadcast_hat();
                    player.name = "Player " + (i + 1);
                }
                chosen["" + sprite] = true;
            }
            i = i + 1;
        }
    };

    game.add_players_to_packet = fn(packet, include_cpu) {
        let i = 0;
        while (i < self.players.length) {
            let player = self.players[i];
            if (player != null && (include_cpu || player.connection != null)) {
                let plr = player.to_array();
                if (i >= self.num_bases && player.connection == null) {
                    plr[0] = null;
                }
                packet.add(plr);
            }
            i = i + 1;
        }
        return packet;
    };

    game.broadcast_names = fn() {
        let i = 0;
        while (i < self.players.length) {
            let player = self.players[i];
            if (player != null) {
                let name_packet = Packet(id.PLAYER_NAME);
                name_packet.add(i);
                name_packet.add(player.name);
                self.server.broadcast(name_packet);
                // Alongside the name, and for the same reason it is broadcast at all: a
                // joiner needs everybody's, and a rejoin needs its own back.
                let vet_packet = Packet(id.PLAYER_VETERAN);
                vet_packet.add(i);
                vet_packet.add(player.veteran);
                self.server.broadcast(vet_packet);
                player.broadcast_custom();
                player.broadcast_hat();
            }
            i = i + 1;
        }
    };

    game.init_new_player = fn(i) {
        let color = null;
        if (i < COLORS.length) { color = COLORS[i]; }
        // Grow array if needed
        while (self.players.length <= i) {
            self.players.push(null);
        }
        self.players[i] = Player(self, i, null, self.server, "Player " + (i + 1), null, null, color);
    };

    game.init_player_connection = fn(i, connection) {
        // get_player, not self.players[i]: a spectator sits past the roster, where the array
        // may not reach yet (it starts at six), and a direct read there throws "Array index
        // out of bounds" -- which kicked the thirteenth client of a twelve-seat lobby and
        // would have kicked the seventh of a four-seat one.
        let player = self.get_player(i);
        if (player == null) {
            self.init_new_player(i);
        }
        self.players[i].connection = connection;
        // The seat belongs to whoever sits in it now: a verified player, or nobody in particular.
        // A seat left by a pinned player is only re-seated with that player (add_connection), and
        // a lobby seat someone else takes must not keep the previous player's sub.
        self.players[i].sub = connection?.sub;
        self.update_player_count();
        self.players[i].ready = (i == self.host);
    };

    game.destroy_player_connection = fn(i) {
        // get_player, NOT self.players[i]. Hemlock THROWS on an out-of-range array read
        // ("Array index N out of bounds"), and this runs from the disconnect handler, where a
        // throw skips everything below it.
        let player = self.get_player(i);
        if (player != null) {
            self.reset_player(i);
            if (self.onevone) {
                // THE LAST CONNECTION DISCONNECTING USED TO THROW RIGHT HERE.
                //
                // `players` is a fixed six-slot array grown only by init_new_player, and
                // spectators go through init_player_connection too -- so a spectator always sits
                // at the TOP index. In onevone, `i + 1` for that seat is one past the end, and
                // reset_player read it raw.
                //
                // The throw landed between the resets and every broadcast below, so PLAYER_LIST,
                // broadcast_names (which carries broadcast_custom and broadcast_hat) and
                // update_player_count never ran -- and back in remove_connection neither did
                // connection.kick(). Every remaining client kept the departed player's custom
                // colours and a stale roster count, having been told only that somebody left.
                //
                // reset_player is bounds-guarded now, so this is a no-op rather than a throw when
                // there is no seat there.
                //
                // THE WHOLE SIDE, not the next seat along.
                //
                // `i + 1` assumed the teammate is adjacent, which is true only on a four-base
                // board. In onevone every base plays and the two sides are 0..half-1 and
                // half..num_bases-1 -- see turn_rotation and the slot assignment in
                // add_connection, which seats humans only at 0 and half. On a six-base board
                // lead 0's teammates are 1 AND 2, so a disconnect freed one of them and left
                // the other standing as a seat with no connection behind it.
                //
                // Derived from half rather than counted, so it holds at any roster size.
                let half = integer(self.num_players / 2);
                let side_lo = 0;
                let side_hi = half;
                if (i >= half) {
                    side_lo = half;
                    // num_players, not num_bases: the upper side ends at the end of the
                    // ROSTER. On a six-base map with a roster of four this walked two seats
                    // that are not in the match.
                    side_hi = self.num_players;
                }
                let t = side_lo;
                while (t < side_hi) {
                    if (t != i) { self.reset_player(t); }
                    t = t + 1;
                }
            }
            let pl_packet = Packet(id.PLAYER_LIST);
            self.add_players_to_packet(pl_packet, true);
            self.server.broadcast(pl_packet);
            self.broadcast_names();
            self.update_player_count();
        }
    };

    game.reset_player = fn(i) {
        // get_player bounds-checks and returns null; a raw read throws. Its callers pass
        // arithmetic (i + 1 from destroy_player_connection), so "the index is always valid"
        // was an assumption about the caller rather than a property of this function.
        let player = self.get_player(i);
        if (player != null) {
            player.connection = null;
            player.name = "Player " + (i + 1);
            player.ready = false;
            player.level = 3;
            if (!self.game_started) {
                player.sprite = null;
                player.symbol = null;
                // A seat left in the lobby is anybody's again. Pinned seats (src/platform.hml)
                // are for coming back to a match under way.
                player.sub = null;
            }
        }
    };

    game.assign_player_colors = fn() {
        let chosen = {};
        let i = 0;
        while (i < self.num_bases) {
            let player = self.players[i];
            // player.color is the seat's PICK, an index into COLORS, once its PLAYER_ADD has
            // arrived -- and until then it is init_new_player's COLORS[i], a colour VALUE, which
            // indexed COLORS with a number in the millions and threw, killing the start. That
            // needs a GAME_START handled before some seat's PLAYER_ADD: never in RaifuWars, where
            // a person presses start, but every few runs of a scripted session that starts the
            // moment everyone is seated (test/realtime_test.hml found it). Anything that is not
            // a valid index is no pick, and gets a free colour below.
            let pick = player.color;
            let is_pick = typeof(pick) != "null" && typeof(pick) != "string" && typeof(pick) != "bool"
                && pick >= 0 && pick < COLORS.length && pick == integer(pick);
            if (player.connection != null && is_pick && chosen["" + pick] == null) {
                chosen["" + player.color] = true;
                player.color = COLORS[player.color];
            } else {
                player.color = null;
            }
            i = i + 1;
        }
        // MORE SEATS THAN COLOURS. A free colour was found by drawing until one was not taken,
        // which never ends once all eight are: a session of nine or more seats (set_seats) hung
        // its start forever. Once every colour is in use they are handed out again in order.
        let used = 0;
        let c = 0;
        while (c < COLORS.length) {
            if (chosen["" + c] == true) { used = used + 1; }
            c = c + 1;
        }
        i = 0;
        while (i < self.num_bases) {
            let player = self.players[i];
            if (player.color == null) {
                if (used >= COLORS.length) {
                    player.color = COLORS[i % COLORS.length];
                } else {
                    let color = 0;
                    while (chosen["" + color] == true) {
                        color = randint(0, 7);
                    }
                    player.color = COLORS[color];
                    chosen["" + color] = true;
                    used = used + 1;
                }
            }
            i = i + 1;
        }
    };

    game.start_game = fn() {
        if (self.game_started) { return; }
        self.game_started = true;
        send_event("isStarted", 1);

        // THE CLIENT'S RULE, VERBATIM: initMatchTurnOrder says
        // `turnOffset = numTeams == 2 ? 1 : 0` -- two-team splits start on player 1,
        // everything else on player 0. This used to be a second, hand-written copy of that
        // rule (`num_bases != num_teams`), and the two disagreed the moment a mode existed
        // where teams and bases legitimately differ: zombies (num_teams 1, bases 4) made the
        // server start at turn 1 while every client started at turn 0, so the server's
        // valid_player_packet gate silently dropped every packet the real current player
        // sent -- the whole match dead at the first action, no error anywhere. The same
        // mismatch was latent for a reduced roster (GAME_NUM_PLAYERS) on a bigger map.
        // One rulebook: if the client's rule changes, change THIS line to match, not to
        // something equivalent-looking.
        // The client's rule gained a second clause on 26 Sep (RaifuWars 62625e5c1, "a duel
        // opens on player 1 again"): a two-team split starts on player 1 only when there are
        // MORE THAN TWO seats. A plain duel is num_teams 2 and num_players 2, and it had been
        // opening on player 2 for four years.
        //
        // That change was made on the client alone, and this line is the other half of the
        // rulebook the comment above insists on. The result is the exact failure that comment
        // describes: in any two-seat match the server started on player 1 while every client
        // started on player 0, so valid_player_packet rejected the host's very first end-turn
        // -- no broadcast, no end_turn, no error, and every client sat on turn 0 until one
        // timed out. Measured: `ENDTURN rx i=0 cur=1 conns=10 live=3` six seconds after
        // GAME_START, then ninety-three seconds of nothing.
        //
        // It hid because it needs a TWO-SEAT online match, and the only stages that make one
        // are the RW_NET_RESIZE scenarios -- net_resize and net_spectate -- neither of which
        // had run since the client change.
        let is_teams = self.num_teams == 2 && self.num_players > 2;
        let turn_offset = 0;
        if (is_teams) { turn_offset = 1; }
        self.turn = turn_offset;
        self.cur_player = turn_offset;
        self.last_coin = self.turn;
        if (self.map != null) { self.map.coins = []; }

        self.reset_seed();
        let seed_packet = Packet(id.GAME_SEED);
        seed_packet.add(self.seed);
        self.server.broadcast(seed_packet);

        if (self.random_bases) {
            self.bases = [];
            let i = 0;
            while (i < self.num_bases) {
                self.bases.push(i);
                i = i + 1;
            }
            self.bases = shuffle(self.bases);
            let base_packet = Packet(id.GAME_BASE);
            base_packet.add(self.bases);
            self.server.broadcast(base_packet);
        }

        self.set_random_players();
        self.assign_player_colors();
        let start_packet = Packet(id.GAME_START);
        self.add_players_to_packet(start_packet, true);
        self.server.broadcast(start_packet);
        self.broadcast_names();

        // A fresh log for the match, opened by the server's own `start`.
        if (self.actions_on) {
            self.seq = 0;
            self.action_log = [];
            self.legacy_dropped = {};
            let start_args = {};
            start_args.timer_s = self.timer_s();
            self.append_action(self.turn, self.current_seat(), "start", stringify(start_args), -1, -1, "");
            self.restart_deadline();
        }

        let j = 0;
        while (j < self.num_bases) {
            self.players[j].ready = false;
            j = j + 1;
        }
        if (self.on_started != null) { self.on_started(); }
    };

    game.end_game = fn(connection, packet) {
        if (!self.game_started) { return; }
        self.game_started = false;
        self.deadline_ms = 0;
        self.deadline_turn = -1;
        send_event("isStarted", 0);
        connection.broadcast(packet);
        if (self.on_ended != null) { self.on_ended(); }

        let j = 0;
        while (j < self.num_bases) {
            let is_host_player = (j == self.host);
            self.players[j].ready = is_host_player;
            if (self.onevone) {
                let half = integer(self.num_players / 2);
                if (j != 0 && j != half) {
                    self.players[j].ready = true;
                }
            }
            j = j + 1;
        }
    };

    game.decode_map = fn() {
        // .buf, not the accumulator: Map() and everything downstream of it want the bytes.
        self.map = Map(self.map_data.buf, self);
        // BOTH, and map_bytes is the one that is easy to forget. `map_data == null` is what
        // says "the next MAP_UPLOAD packet is a length, not a chunk", so leaving map_bytes at
        // the old map's size is harmless today and would be a silent truncation the moment
        // anything read it. A host CAN change map: they back out of the lobby and pick again.
        self.map_data = null;
        self.map_bytes = 0;
    };

    game.update_player_count = fn() {
        let count = 0;
        let i = 0;
        while (i < self.num_bases) {
            if (self.players[i].connection != null) {
                count = count + 1;
            }
            i = i + 1;
        }
        if (count > 0) { send_event("players", count); }
    };

    game.all_players_ready = fn() {
        let i = 0;
        while (i < self.num_bases) {
            let player = self.players[i];
            if (!player.ready && player.connection != null) { return false; }
            i = i + 1;
        }
        return true;
    };

    game.set_allow_spectators = fn(allow) {
        self.spectators = allow;
        send_event("spectators", allow);
        if (!allow) {
            let i = self.num_bases;
            while (i < self.players.length) {
                let player = self.players[i];
                if (player != null && player.connection != null) {
                    player.kick("Spectators are not allowed.");
                }
                i = i + 1;
            }
        }
    };

    game.set_game_length = fn(len) {
        self.game_length = len;
        send_event("gameLength", len);
    };

    game.set_game_mode = fn(mode) {
        self.game_mode = mode;
        // Zombies (mode 2) is cooperative: one team, always. The client forces this locally on
        // selecting the mode, but the SERVER's stored num_teams is what the join-time settings
        // replay sends -- and it sends GAME_TEAMS AFTER GAME_MODE, so a stale split here
        // clobbered the joiner's forced value and its roster baked into enemy teams. One
        // measured symptom: a joiner's AI shooting its own teammates while the host rejected
        // every such attack as friendly fire.
        if (mode == 2) { self.num_teams = 1; }
        send_event("gameMode", mode);
    };

    game.set_game_speed = fn(speed) {
        self.game_speed = speed;
        send_event("gameSpeed", speed);
    };

    game.set_game_timer = fn(timer) { self.game_timer = timer; };
    game.set_random_bases = fn(enable) { self.random_bases = enable; };
    game.set_sudden_death = fn(enable) { self.sudden_death = enable; };
    game.set_attack_damage = fn(dmg) { self.attack_damage = dmg; };
    game.set_num_teams = fn(teams) { self.num_teams = teams; };

    // THE CLAMP LIVES HERE, not at the packet. Every route into the roster size goes through
    // this -- the GAME_NUM_PLAYERS packet, set_one_v_one, and a map load -- so putting the bounds
    // at one caller would leave the others able to set a count no map can seat.
    //
    // Bounds, and why each one:
    //   num_bases   a four-base map cannot seat six however hard the lobby asks
    //   2           a match needs two sides
    //   even        team play halves the roster and the CLIENT rounds nowhere, so an odd count is
    //               a silently mismatched team rather than an error
    game.set_num_players = fn(players) {
        let want = players;
        if (want > self.num_bases) { want = self.num_bases; }
        if (want < 2) { want = 2; }
        want = want - (want % 2);
        // THE CLIENT'S RULE, VERBATIM (setNumPlayers): Free-For-All is num_teams ==
        // numPlayers, a RELATIONSHIP -- re-established at the new count, not preserved as a
        // number. Every client applies this when it applies GAME_NUM_PLAYERS, so a server
        // that does not moves alone: the clients settled on num_teams 2 for a resized duel,
        // the server kept 4, the start offsets (num_teams == 2, see start_game) diverged,
        // and the server dropped the real current player's every packet. The same
        // one-rulebook failure as the start_game offset bug, one field over.
        let was_ffa = self.num_teams == self.num_players;
        self.num_players = want;
        if (was_ffa) { self.num_teams = want; }
        send_event("numPlayers", want);
        return want;
    };

    // ONE MEANING FOR num_players: THE ROSTER. It used to have two.
    //
    // This set num_players to 2 in 1v1 -- COMMANDERS, not raifus -- while every client reads
    // GAME_NUM_PLAYERS as the roster and bakes that many seats (initMatchPlayers loops
    // `i < global.numPlayers`). So a 1v1 lobby ended with three different boards: the host on
    // its own untouched count, the server on 2, and a joiner that applied the 2 literally and
    // built a two-raifu match. Measured on Colosseum: host 4 seats, server 6 bases and 2
    // players, joiner 2 seats, and every `half` in between disagreeing about where the second
    // commander sits.
    //
    // The two meanings had already been noticed once and patched around rather than removed --
    // turn_rotation carried an `if (self.onevone) return num_bases` whose comment says
    // outright that num_players "cannot be the rotation length there". That workaround goes
    // with this: once num_players is the roster, it is the rotation length like everywhere
    // else.
    //
    // THE CLIENT IS THE SPEC HERE. handleTeam1v1Button calls setOneVOne(true) and
    // setTeams(2) and does NOT touch global.numPlayers -- picking 1v1 squads changes who
    // COMMANDS the seats, never how many there are. This now does exactly the same nothing,
    // and a map load broadcasts the roster for a 1v1 lobby the same as for any other (see
    // map.hml, which used to skip it).
    game.set_one_v_one = fn(enable) {
        self.onevone = enable;
    };

    game.set_tier_options = fn(option) { self.tier_options = option; };

    game.toggle_deck_card = fn(i, enabled) { self.deck.cards[i] = enabled; };

    // How many seats actually take turns: the ROSTER, not the map. A four-base lobby
    // resized to a duel rotates over two players, exactly as every client does (they bake
    // numPlayers seats) -- rotating over num_bases put the server two seats out of step
    // with the whole lobby the first time a reduced roster played, and every packet from
    // the real current player was then dropped as out-of-turn.
    //
    // 1v1 IS NOT AN EXCEPTION ANY MORE. It used to be, because set_one_v_one redefined
    // num_players as a commander count; every base plays in 1v1 (the leads' CPU teammates
    // take their own turns), so the rotation had to be read off num_bases instead. Now that
    // num_players is the roster in every mode, it is the rotation length in every mode -- and
    // a 1v1 lobby on a six-base map with a roster of four rotates over four, which is what
    // the clients bake and what num_bases could never have said.
    // A session with no map has no base count to read, so it keeps the default four. A game
    // that wants more seats (start_server's opts.seats; Biplane Battle! seats up to 32) sets
    // them here: the roster, the bases and a player for every seat, because start_game and
    // its helpers index players[0..num_bases-1] and a missing one throws.
    game.set_seats = fn(n) {
        self.num_bases = n;
        self.num_players = n;
        self.num_teams = n;
        self.bases = [];
        let i = 0;
        while (i < n) {
            self.bases.push(i);
            if (i >= self.players.length || self.players[i] == null) { self.init_new_player(i); }
            i = i + 1;
        }
        // The router lists the lobby's seats from this; without it a lobby of eight was shown
        // as one of four, the router's default.
        send_event("numPlayers", n);
    };

    game.turn_rotation = fn() {
        let n = self.num_players;
        if (n < 2) { n = 2; }
        if (n > self.num_bases) { n = self.num_bases; }
        return n;
    };

    // The server's turn bookkeeping. In a 1.15 match it runs only behind an `end` action (an
    // intent or server_end) and sends no PLAYER_LUCK: randomness travels in each action's seed.
    game.end_turn = fn() {
        if (!self.actions_on) {
            let luck = randf(0.0, 1.0);
            let luck_packet = Packet(id.PLAYER_LUCK);
            luck_packet.add(luck);
            self.server.broadcast(luck_packet);
        }

        self.turn = self.turn + 1;
        self.cur_player = self.turn % self.turn_rotation();

        // Coin spawn logic
        if (self.map != null && self.turn >= self.last_coin + 10 && self.map.coins.length < 3) {
            let rand = randf(0.0, 1.0);
            let coin_chance = 0.25;
            if (rand <= coin_chance) {
                self.last_coin = self.turn;
                self.map.spawn_coin();
            }
        }
        // Every way the turn advances comes through here, so the deadline restarts here.
        if (self.actions_on) { self.restart_deadline(); }
    };

    // ---- 1.15: the action log ----

    game.current_seat = fn() {
        return self.turn % self.turn_rotation();
    };

    // The lobby's turn timer in seconds, -1 for none (GAME_TIMER; anything not positive is none).
    game.timer_s = fn() {
        let t = self.game_timer;
        let ty = typeof(t);
        if (ty == "null" || ty == "string" || ty == "bool" || ty == "object" || ty == "array") { return -1; }
        if (t <= 0) { return -1; }
        return t;
    };

    // The deadline's clock: time_ms(). A method so a test can run the clock by hand.
    game.now_ms = fn() { return time_ms(); };

    game.restart_deadline = fn() {
        let t = self.timer_s();
        if (t > 0) {
            self.deadline_ms = self.now_ms() + t * 1000;
            self.deadline_turn = self.turn;
        } else {
            self.deadline_ms = 0;
            self.deadline_turn = -1;
        }
    };

    // Called on the server's loop (start_server's ticker). Ends the turn once at its deadline;
    // a deadline set for an earlier turn is discarded, never fired.
    game.check_deadline = fn() {
        let now = self.now_ms();
        if (!self.actions_on || !self.game_started || self.deadline_ms <= 0) { return false; }
        if (self.deadline_turn != self.turn) {
            self.deadline_ms = 0;
            self.deadline_turn = -1;
            return false;
        }
        if (now < self.deadline_ms) { return false; }
        self.deadline_ms = 0;
        self.deadline_turn = -1;
        print("turn " + self.turn + " timed out");
        self.server_end("timeout");
        return true;
    };

    game.action_packet = fn(a) {
        let p = Packet(id.ACTION);
        p.add(a.seq);
        p.add(a.turn);
        p.add(a.seat);
        p.add(a.type);
        p.add(a.args);
        p.add(a.seed);
        p.add(a.origin);
        p.add(a.client_seq);
        p.add(a.check);
        return p;
    };

    // Next seq, a fresh seed, into the log, out to everyone (the sender too).
    game.append_action = fn(turn, seat, kind, args, origin, client_seq, check) {
        self.seq = self.seq + 1;
        let a = {
            seq: self.seq,
            turn: turn,
            seat: seat,
            type: kind,
            args: args,
            seed: randint(0, SEED_MAX),
            origin: origin,
            client_seq: client_seq,
            check: check,
        };
        self.action_log.push(a);
        self.server.broadcast(self.action_packet(a));
        return a;
    };

    // A server-originated `end` for the current seat: why is "timeout", "disconnect",
    // "host_migration" or "rejoin". Carries the next turn's timer like every end.
    game.server_end = fn(why) {
        let args = {};
        args.timer_s = self.timer_s();
        args.why = why;
        self.append_action(self.turn, self.current_seat(), "end", stringify(args), -1, -1, "");
        self.end_turn();
    };

    // Does connection slot i drive seat `seat` as a player? Its own seat, or -- in 1v1 -- any
    // seat on its side (the commander drives its CPU teammates). The host-for-a-CPU rule is
    // separate (intent_refusal) because it follows the host, not the seat.
    game.drives_seat = fn(i, seat) {
        if (i == null || seat == null) { return false; }
        if (i >= self.turn_rotation()) { return false; }
        if (seat == i) { return true; }
        if (self.onevone) {
            let half = integer(self.num_players / 2);
            if ((i < half && seat < half) || (i >= half && seat >= half)) { return true; }
        }
        return false;
    };

    // Why slot i may not act for `seat` on `turn` now, or null when it may. is_host is the
    // packet handler's (a public match has none).
    game.intent_refusal = fn(i, is_host, turn, seat) {
        if (!self.actions_on || !self.game_started) { return "not running"; }
        if (i == null) { return "not seated"; }
        if (turn == null || turn != self.turn) { return "stale turn"; }
        if (seat == null || seat != self.current_seat()) { return "not the current seat"; }
        let player = self.get_player(seat);
        if (player == null) { return "not the current seat"; }
        if (self.drives_seat(i, seat)) { return null; }
        if (is_host && player.is_cpu()) { return null; }
        return "not your seat";
    };

    // An ACTION_INTENT from slot i: null when accepted (and broadcast), else the reason to send
    // back in ACTION_REJECT. Raw packet values; everything is checked here.
    game.submit_intent = fn(i, is_host, client_seq, turn, seat, kind, args, check) {
        if (as_int(client_seq) == null) { return "bad intent"; }
        let t = as_int(turn);
        let st = as_int(seat);
        if (typeof(kind) != "string" || kind.length == 0 || kind.length > MAX_TYPE) { return "bad type"; }
        if (kind == "start") { return "bad type"; }
        // New locals rather than reassigned parameters, and nothing declared as a bare null
        // and filled in later: hemlockc keeps such a variable typed null (hemlang/hemlock#678).
        let a = "{}";
        if (args != null && args != "") { a = args; }
        if (typeof(a) != "string" || a.length > MAX_ARGS) { return "bad args"; }
        let c = "";
        if (check != null) { c = check; }
        if (typeof(c) != "string" || c.length > MAX_CHECK) { return "bad check"; }
        let why = self.intent_refusal(i, is_host, t, st);
        if (why != null) { return why; }
        // Legality of the JSON at the door: every client parses args when it applies the action,
        // so one that does not parse would stop every board at once.
        let obj = parse_object(a);
        if (obj == null) { return "bad args"; }
        if (kind == "end") {
            obj.timer_s = self.timer_s();
            a = stringify(obj);
        }
        self.append_action(t, st, kind, a, i, as_int(client_seq), c);
        if (kind == "end") { self.end_turn(); }
        return null;
    };

    // ACTION_LOG_REQUEST: every logged action from fromSeq on, in order, then ACTION_LOG_END.
    game.send_log = fn(connection, from_seq) {
        let from = as_int(from_seq);
        if (from == null || from < 1) { from = 1; }
        let k = from - 1;
        while (k < self.action_log.length) {
            connection.send(self.action_packet(self.action_log[k]));
            k = k + 1;
        }
        let end_packet = Packet(id.ACTION_LOG_END);
        end_packet.add(self.seq);
        connection.send(end_packet);
    };

    // A retired packet during a 1.15 match: dropped, and said so once per id per match.
    game.drop_retired = fn(net_id) {
        let key = "" + net_id;
        if (self.legacy_dropped[key] == null) {
            self.legacy_dropped[key] = true;
            print("1.15: dropping retired packet " + net_id + " during a match (logged once per match)");
        }
    };

    game.is_retired = fn(net_id) {
        let k = 0;
        while (k < RETIRED.length) {
            if (RETIRED[k] == net_id) { return true; }
            k = k + 1;
        }
        return false;
    };

    // Initialize
    game.reset_seed();
    let i = 0;
    while (i < 6) {
        game.init_new_player(i);
        i = i + 1;
    }

    return game;
}
