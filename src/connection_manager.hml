// connection_manager.hml — Player connection lifecycle

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";
import { Session } from "../lib/session.hml";
import { send_event } from "../lib/lobby.hml";
import { SaveData } from "./save_data.hml";
import { sleep } from "@stdlib/time";
import { exit } from "@stdlib/process";

export fn ConnectionManager(server, game) {
    let cm = {
        connections: [null, null, null, null, null, null, null, null, null, null],
        server: server,
        game: game,
        session: Session(server, id.PLAYER_KICK),
        // The password lockout's shared counter -- see LOBBY_PASSWORD in packet_handler.
        pass_fails: 0,
        pass_fail_at: 0,

        // Has every connected client confirmed it loaded the CURRENT map? Acks store the
        // hash, so a map change staleness them automatically -- no reset bookkeeping. False
        // while no map exists: there is nothing to have confirmed.
        all_map_acked: fn() {
            let g = self.game;
            if (g.map == null || g.map.hash == null) { return false; }
            let i = 0;
            while (i < self.connections.length) {
                let c = self.connections[i];
                if (c != null) {
                    // TWO steps, not one `!=`: an unacked connection's map_ack is null, and
                    // a null-vs-string comparison in Hemlock is the rune-vs-string trap from
                    // PROTOCOL.md 5b -- always false, no error -- which made this gate
                    // vacuously true and the deferral never fire once.
                    let acked = c?.map_ack;
                    if (acked == null) { return false; }
                    if (acked != g.map.hash) { return false; }
                }
                i = i + 1;
            }
            return true;
        },
        add_connection: fn(connection) {
            let g = self.game;

            // Reject if game isn't ready (host connected but no map)
            if (self.connections[g.host] != null && (g.map == null || g.map.hash == null)) {
                self.session.kick(connection, "Game isn't ready.");
                return;
            }

            // Check for reconnection by UID.
            //
            // `connection?.uid`, NOT `connection.uid`. Hemlock THROWS on reading a field an
            // object does not have; JavaScript yields undefined. gn.js set `uid` only on a
            // reconnect, so `connection.uid != null` was the natural way to ask "is this a
            // reconnect" -- and porting that expression unchanged made the connect handler throw
            // on every FIRST connection, which the server then kicked.
            //
            // Every client was rejected. The symptom at the other end is a WebSocket that opens
            // and immediately closes, which reads as a network problem rather than a server one.
            let conn_id = null;
            if (connection?.uid != null) {
                let i = 0;
                while (i < g.num_bases) {
                    let plr = g.get_player(i);
                    if (plr.uid == connection.uid && plr.connection == null) {
                        conn_id = i;
                        break;
                    }
                    i = i + 1;
                }
            }

            // Find lowest available slot
            let half = integer(g.num_players / 2);
            if (conn_id == null) {
                let i = 0;
                while (conn_id == null) {
                    if (g.onevone) {
                        if (i != 0 && i != half && i < g.num_players) {
                            i = i + 1;
                            continue;
                        }
                    }
                    if (self.connections[i] == null) {
                        conn_id = i;
                    }
                    i = i + 1;
                }
            }

            // Grow connections array if needed
            while (self.connections.length <= conn_id) {
                self.connections.push(null);
            }
            self.connections[conn_id] = connection;
            self.session.set_connection(conn_id, connection);

            // Add to player slots. The seat boundary is the ROSTER (turn_rotation), not the
            // map: a four-base lobby resized to two seats two players, and a third arrival
            // spectates rather than occupying a chair no turn will ever reach. (Resizing
            // BELOW already-seated connections is not handled here or anywhere -- the lobby
            // UI does not offer it; noted rather than solved.)
            if (conn_id < g.turn_rotation() || g.spectators) {
                g.init_player_connection(conn_id, connection);
            } else {
                self.session.kick(connection, "Game is full!");
                return;
            }

            // Broadcast new connection
            let connect_packet = Packet(id.CLIENT_CONNECT);
            connect_packet.add(conn_id);
            self.server.broadcast(connect_packet);

            // Send client ID
            let init_packet = Packet(id.CLIENT_INIT);
            init_packet.add(conn_id);
            connection.send(init_packet);

            // Send game seed
            let seed_packet = Packet(id.GAME_SEED);
            seed_packet.add(g.seed);
            connection.send(seed_packet);

            // Send game options
            let gamelen_packet = Packet(id.GAME_LENGTH);
            gamelen_packet.add(g.game_length);
            connection.send(gamelen_packet);

            let gametimer_packet = Packet(id.GAME_TIMER);
            gametimer_packet.add(g.game_timer);
            connection.send(gametimer_packet);

            let mode_packet = Packet(id.GAME_MODE);
            mode_packet.add(g.game_mode);
            connection.send(mode_packet);

            let tier_packet = Packet(id.GAME_TIER_OPTIONS);
            tier_packet.add(g.tier_options);
            connection.send(tier_packet);

            let attack_packet = Packet(id.GAME_ATTACK_DAMAGE);
            attack_packet.add(g.sudden_death);
            attack_packet.add(g.attack_damage);
            connection.send(attack_packet);

            let teams_packet = Packet(id.GAME_TEAMS);
            teams_packet.add(g.num_teams);
            connection.send(teams_packet);

            let onevone_packet = Packet(id.GAME_ONEVONE);
            onevone_packet.add(g.onevone);
            connection.send(onevone_packet);

            let bases_packet = Packet(id.GAME_BASE);
            bases_packet.add(g.random_bases);
            connection.send(bases_packet);

            // Three settings a host can change that were NOT in this replay, found by
            // auditing every settable value against this list -- the same audit that caught
            // GAME_TEAMS clobbering GAME_MODE's forced value (fixed by making the stored
            // settings self-consistent; see set_game_mode). A joiner missing num_players
            // derives the roster from the map and disagrees with the lobby about which slots
            // exist -- the exact disagreement GAME_NUM_PLAYERS was added to remove, reopened
            // for anyone who joins after the host resizes.
            let np_packet = Packet(id.GAME_NUM_PLAYERS);
            np_packet.add(g.num_players);
            connection.send(np_packet);

            let speed_packet = Packet(id.GAME_SET_SPEED);
            speed_packet.add(g.game_speed);
            connection.send(speed_packet);

            let spec_packet = Packet(id.LOBBY_SPECTATORS);
            spec_packet.add(g.spectators);
            connection.send(spec_packet);

            // The lobby's name, which joiners never learned before -- stored by the host's
            // LOBBY_NAME, replayed here. Skipped when unset so old clients with no handler
            // for it see nothing new unless a name exists to tell them.
            if (g.lobby_name != "") {
                let name_packet = Packet(id.LOBBY_NAME);
                name_packet.add(g.lobby_name);
                connection.send(name_packet);
            }

            // Deck options
            let deck_packet = Packet(id.GAME_DECK);
            deck_packet.add(g.deck.cards);
            connection.send(deck_packet);
            g.deck.serialize_and_send(connection);

            // Current host
            let host_packet = Packet(id.PLAYER_HOST);
            host_packet.add(g.host);
            connection.send(host_packet);

            // Spectator status
            let spectate_packet = Packet(id.LOBBY_SPECTATORS);
            spectate_packet.add(g.spectators);
            connection.send(spectate_packet);

            // Send map hash and game speed if not host
            if (conn_id != g.host) {
                let map_packet = Packet(id.MAP_HASH);
                map_packet.add(g.map.hash);
                connection.send(map_packet);

                let speed_packet = Packet(id.GAME_SET_SPEED);
                speed_packet.add(g.game_speed);
                connection.send(speed_packet);
            }

            // Catch up mid-game state
            if (g.game_started) {
                let save_packet = Packet(id.GAME_SAVE);
                self.server.broadcast(save_packet);

                let cur_player = g.cur_player;
                let is_current = cur_player == conn_id;
                let is_onevone_team = false;
                if (g.onevone && conn_id < g.num_players) {
                    if (cur_player < half && conn_id < half) {
                        is_onevone_team = true;
                    } else if (cur_player >= half && conn_id >= half) {
                        is_onevone_team = true;
                    }
                }
                if (is_current || is_onevone_team) {
                    let endturn_packet = Packet(id.PLAYER_ENDTURN);
                    connection.broadcast(endturn_packet);
                    g.end_turn();
                }
            }

            // EVERY SEATED PLAYER'S LOOK, because nothing else on this path carries it.
            //
            // PLAYER_LIST is [client_num, sprite, symbol, color, ready, is_cpu, level] -- the
            // team colour, not the four CUSTOM colours or the hat. Those travel only in
            // PLAYER_CUSTOM and PLAYER_HAT, which are broadcast on a disconnect, at GAME_START,
            // and when an owner re-asserts its own. None of those is a join.
            //
            // So a client arriving in a lobby saw default colours for everyone already there,
            // permanently. It re-asserts its OWN look through addSelfToLobby, so the people
            // already seated see the newcomer correctly and nobody at the table notices -- only
            // the person who just arrived, looking at everyone else.
            //
            // MID-GAME JOINS WERE ALREADY COVERED and that is why this went unnoticed for so
            // long: above, a join with game_started broadcasts GAME_SAVE, the host uploads the
            // whole match, every client reloads it, and deserializeAndLoadGameData restores
            // eyeColor, hairColor, uniformColor, skinColor and hat. The lobby has no snapshot,
            // so the lobby had no colours.
            //
            // SENT, NOT BROADCAST. broadcast_custom would re-tell the whole table something it
            // already knows, once per player, on every join. The newcomer is the only one
            // missing this.
            let ci = 0;
            while (ci < g.players.length) {
                let seated = g.get_player(ci);
                if (seated != null) {
                    let custom_packet = Packet(id.PLAYER_CUSTOM);
                    custom_packet.add(ci);
                    custom_packet.add(seated.eye_color);
                    custom_packet.add(seated.hair_color);
                    custom_packet.add(seated.uniform_color);
                    custom_packet.add(seated.skin_color);
                    connection.send(custom_packet);

                    let hat_packet = Packet(id.PLAYER_HAT);
                    hat_packet.add(ci);
                    hat_packet.add(seated.hat);
                    connection.send(hat_packet);
                }
                ci = ci + 1;
            }

            print("Connection opened (" + conn_id + ")");
        },

        remove_connection: fn(connection) {
            let conn_id = self.get_id_from_connection(connection);

            // A connection that was never ADDED still disconnects, and get_id_from_connection
            // returns null for it -- indexing with null then throws "Index must be an integer"
            // inside the disconnect handler. That is not hypothetical: while the uid bug above
            // was kicking every client, every one of those kicks produced this second error on
            // the way out, which buried the first.
            //
            // Rejected connections are the normal case here, not an edge case: a full lobby, a
            // wrong password and a game already started all reach this path.
            if (conn_id == null) {
                print("Connection closed (never joined)");
                return;
            }

            self.connections[conn_id] = null;
            self.session.clear_connection(conn_id);

            // Handle host disconnection
            if (self.connections[self.game.host] == null) {
                let new_host = null;
                let i = 0;
                while (i < self.game.num_bases && new_host == null) {
                    if (self.connections[i] != null) {
                        new_host = i;
                    }
                    i = i + 1;
                }
                if (new_host != null) {
                    self.game.switch_host(new_host);
                } else {
                    self.kill_server(2);
                    return;
                }
            }

            if (conn_id != null) {
                print("Connection closed (" + conn_id + ")");
                let disconnect_packet = Packet(id.CLIENT_DISCONNECT);
                disconnect_packet.add(conn_id);
                self.server.broadcast(disconnect_packet);
                self.game.destroy_player_connection(conn_id);
            } else {
                print("Connection refused");
            }

            connection.kick();
        },

        swap_connections: fn(i, j, broadcast) {
            if (broadcast) {
                let swap_packet = Packet(id.PLAYER_SWAP);
                swap_packet.add(i);
                swap_packet.add(j);
                self.server.broadcast(swap_packet);
            }
            let temp = self.connections[i];
            self.connections[i] = self.connections[j];
            self.connections[j] = temp;
            self.game.swap_players(i, j);

            let pl_packet = Packet(id.PLAYER_LIST);
            self.game.add_players_to_packet(pl_packet, true);
            self.server.broadcast(pl_packet);
        },

        get_id_from_connection: fn(connection) {
            if (connection == null) { return null; }
            let i = 0;
            while (i < self.connections.length) {
                if (self.connections[i] == connection) { return i; }
                i = i + 1;
            }
            return null;
        },

        kill_server: fn(code) {
            // NAME THE CODE. Every path out of a lobby ends here and the client is told only
            // "Server closed.", so from the outside a host timeout, a heartbeat expiry, a
            // malformed upload and the 24-hour cap are indistinguishable -- and three of the
            // four look like a network fault to the player. The codes are: 0 malformed
            // upload, 1 no host connected in time, 2 last connection left, 24 max lifetime.
            print("Killing server, code " + code);
            self.session.kick_all("Server closed.");
            self.session.close();
            self.server.close();
            exit(code);
        },

        solicit_lobby_password: fn(connection) {
            let packet = Packet(id.LOBBY_PASSWORD);
            connection.send(packet);
        },

        set_one_v_one_players: fn() {
            let g = self.game;

            // integer(), AND THIS IS THE FUNCTION THAT PROVED WHY.
            //
            // `6 / 2` is 3.0 in Hemlock, not 3, and an array index must be an integer --
            // `a[3.0]` throws "Index must be an integer". `half` is used as a slot number
            // below (other_slot, and the swap_connections calls that index with it), so the
            // very first GAME_ONEVONE packet a host ever sent threw right here.
            //
            // The throw landed inside handle_packet, so server.hml's `on("error")` caught it,
            // sent the HOST a PLAYER_KICK reading "An error occurred sending data." and closed
            // its connection. The host then left the lobby before it had uploaded its map, and
            // the failure presented to the harness as "the host never announced a ready lobby"
            // -- a timeout three steps downstream of the packet that actually killed it.
            //
            // So 1v1 Squads has never worked online, at any roster size, since the option
            // existed. Nothing caught it because no test had ever sent the packet: the only
            // squads assertion anywhere is an OFFLINE flow, which never reaches a server.
            //
            // Comparisons are safe -- Hemlock compares 3 and 3.0 as equal, which is why the
            // five other `num_bases / 2` sites were accidentally fine and one of them,
            // destroy_player_connection, walks a side with it. They are all integer() now
            // anyway: five sites that happen not to index today is not a property worth
            // relying on, and the next person to add an index to one brings this back.
            let half = integer(g.num_players / 2);

            // Move host to slot 0 or half
            let host = g.host;
            let host_slot = 0;
            if (host >= half) { host_slot = half; }
            if (host_slot != host) { self.swap_connections(host, host_slot, true); }

            // THE OTHER COMMANDER -- IF THERE IS ONE.
            //
            // This took the first slot that is not the host's, OCCUPIED OR NOT. A host toggling
            // 1v1 in an empty lobby is the NORMAL order, not an edge case: the teams row sits
            // above the confirm button on the setup screen, so squads is chosen before anybody
            // else can possibly have joined. It therefore swapped two empty seats and broadcast
            // a PLAYER_SWAP for them, churning every client's staged roster to no purpose.
            //
            // An empty lobby needs no reseat at all: add_connection already offers only slot 0
            // and slot half while onevone is set, so whoever arrives next lands on a commander
            // seat without being moved.
            let other_conn = null;
            let i = 0;
            while (i < g.num_players) {
                if (i != host_slot && self.connections[i] != null) {
                    other_conn = i;
                    break;
                }
                i = i + 1;
            }
            let other_slot = half;
            if (host_slot != 0) { other_slot = 0; }
            if (other_conn != null && other_conn != other_slot) {
                self.swap_connections(other_conn, other_slot, true);
            }

            // Move remaining CONNECTIONS to spectators or kick.
            //
            // Occupied seats only. reset_player on an empty one is harmless but
            // set_player_as_spectator is not -- it allocates a spectator slot and renumbers,
            // and it was being run for every empty seat on the board.
            i = 0;
            while (i < g.num_players) {
                if (i != host_slot && i != other_slot && self.connections[i] != null) {
                    let player = g.get_player(i);
                    if (g.spectators) {
                        self.set_player_as_spectator(i);
                    } else if (player != null) {
                        player.kick("Game is full.");
                    }
                    g.reset_player(i);
                }
                i = i + 1;
            }
        },

        set_player_as_spectator: fn(i) {
            let g = self.game;
            let slot = g.num_bases;
            let n = g.players.length;
            let spec_id = slot;
            let j = slot;
            while (j <= n) {
                let player = g.players[j];
                if (player == null) {
                    g.init_new_player(j);
                    spec_id = j;
                    break;
                } else if (player.connection == null) {
                    spec_id = j;
                    break;
                }
                j = j + 1;
            }
            self.swap_connections(i, spec_id, true);
        },
    };

    // Start session timers
    cm.session.start_timers(game.host, fn(reason) {
        if (reason == "host_timeout") {
            // ONLY BEFORE THE MATCH STARTS. This watchdog means "nobody ever turned up to the
            // lobby they asked for". Once a game is running, an empty host slot means the host
            // LEFT -- which is a migration, handled by remove_connection, and emphatically not a
            // reason to end everyone else's match.
            //
            // Without this guard, killing the host killed the whole session: the survivors were
            // disconnected mid-match and the server exited. Found by RW_NET_KILL=host, which is
            // the first thing that ever pulled a host out of a live game.
            //
            // Why it fires late at all: the task sleeps HOST_CONNECT_TIMEOUT once and then
            // checks. Its continuation is not guaranteed to run the instant the sleep expires --
            // it runs when the event loop next gets to it, and in a quiet match that turned out
            // to be the moment the host's socket closed. So the check ran with exactly the state
            // that makes it fire, an hour of match-time after it was relevant.
            if (game.game_started) {
                print("Ignoring host_timeout: the match has started, this is a migration");
                return;
            }
            cm.kill_server(1);
        } else if (reason == "max_lifetime") {
            cm.kill_server(24);
        } else {
            // Heartbeat timeout — parse slot from "heartbeat:N"
            //
            // `number`, because split() yields STRINGS and `connections["1"]` is not
            // `connections[1]`. The reason is built by joining the index onto a label, so the
            // number survives the round trip only if it is converted back.
            let parts = reason.split(":");
            if (parts.length == 2 && parts[0] == "heartbeat") {
                let slot = number(parts[1]);
                print("Heartbeat timeout on slot " + slot);
                let conn = cm.connections[slot];
                if (conn != null) {
                    cm.remove_connection(conn);
                }
            }
        }
    });

    return cm;
}
