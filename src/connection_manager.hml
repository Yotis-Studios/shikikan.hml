// connection_manager.hml — Player connection lifecycle

import { Packet } from "Yotis-Studios/gn.hml";
import * as id from "./id.hml";
import { Session } from "../lib/session.hml";
import { send_event } from "../lib/lobby.hml";
import { SaveData } from "./save_data.hml";
import { sleep } from "@stdlib/time";
import { exit } from "@stdlib/process";

export fn ConnectionManager(server, game) {
    let cm = {
        connections: [null, null, null, null, null, null, null, null, null, null],
        server: server,
        game: game,
        session: Session(server, id.PLAYER_KICK),
        add_connection: fn(connection) {
            let g = self.game;

            // Reject if game isn't ready (host connected but no map)
            if (self.connections[g.host] != null && (g.map == null || g.map.hash == null)) {
                self.session.kick(connection, "Game isn't ready.");
                return;
            }

            // Check for reconnection by UID.
            //
            // `connection?.uid`, NOT `connection.uid`. Hemlock THROWS on reading a field an
            // object does not have; JavaScript yields undefined. gn.js set `uid` only on a
            // reconnect, so `connection.uid != null` was the natural way to ask "is this a
            // reconnect" -- and porting that expression unchanged made the connect handler throw
            // on every FIRST connection, which the server then kicked.
            //
            // Every client was rejected. The symptom at the other end is a WebSocket that opens
            // and immediately closes, which reads as a network problem rather than a server one.
            let conn_id = null;
            if (connection?.uid != null) {
                let i = 0;
                while (i < g.num_bases) {
                    let plr = g.get_player(i);
                    if (plr.uid == connection.uid && plr.connection == null) {
                        conn_id = i;
                        break;
                    }
                    i = i + 1;
                }
            }

            // Find lowest available slot
            let half = g.num_bases / 2;
            if (conn_id == null) {
                let i = 0;
                while (conn_id == null) {
                    if (g.onevone) {
                        if (i != 0 && i != half && i < g.num_bases) {
                            i = i + 1;
                            continue;
                        }
                    }
                    if (self.connections[i] == null) {
                        conn_id = i;
                    }
                    i = i + 1;
                }
            }

            // Grow connections array if needed
            while (self.connections.length <= conn_id) {
                self.connections.push(null);
            }
            self.connections[conn_id] = connection;
            self.session.set_connection(conn_id, connection);

            // Add to player slots
            if (conn_id < g.num_bases || g.spectators) {
                g.init_player_connection(conn_id, connection);
            } else {
                self.session.kick(connection, "Game is full!");
                return;
            }

            // Broadcast new connection
            let connect_packet = Packet(id.CLIENT_CONNECT);
            connect_packet.add(conn_id);
            self.server.broadcast(connect_packet);

            // Send client ID
            let init_packet = Packet(id.CLIENT_INIT);
            init_packet.add(conn_id);
            connection.send(init_packet);

            // Send game seed
            let seed_packet = Packet(id.GAME_SEED);
            seed_packet.add(g.seed);
            connection.send(seed_packet);

            // Send game options
            let gamelen_packet = Packet(id.GAME_LENGTH);
            gamelen_packet.add(g.game_length);
            connection.send(gamelen_packet);

            let gametimer_packet = Packet(id.GAME_TIMER);
            gametimer_packet.add(g.game_timer);
            connection.send(gametimer_packet);

            let tier_packet = Packet(id.GAME_TIER_OPTIONS);
            tier_packet.add(g.tier_options);
            connection.send(tier_packet);

            let attack_packet = Packet(id.GAME_ATTACK_DAMAGE);
            attack_packet.add(g.sudden_death);
            attack_packet.add(g.attack_damage);
            connection.send(attack_packet);

            let teams_packet = Packet(id.GAME_TEAMS);
            teams_packet.add(g.num_teams);
            connection.send(teams_packet);

            let onevone_packet = Packet(id.GAME_ONEVONE);
            onevone_packet.add(g.onevone);
            connection.send(onevone_packet);

            let bases_packet = Packet(id.GAME_BASE);
            bases_packet.add(g.random_bases);
            connection.send(bases_packet);

            // Deck options
            let deck_packet = Packet(id.GAME_DECK);
            deck_packet.add(g.deck.cards);
            connection.send(deck_packet);
            g.deck.serialize_and_send(connection);

            // Current host
            let host_packet = Packet(id.PLAYER_HOST);
            host_packet.add(g.host);
            connection.send(host_packet);

            // Spectator status
            let spectate_packet = Packet(id.LOBBY_SPECTATORS);
            spectate_packet.add(g.spectators);
            connection.send(spectate_packet);

            // Send map hash and game speed if not host
            if (conn_id != g.host) {
                let map_packet = Packet(id.MAP_HASH);
                map_packet.add(g.map.hash);
                connection.send(map_packet);

                let speed_packet = Packet(id.GAME_SET_SPEED);
                speed_packet.add(g.game_speed);
                connection.send(speed_packet);
            }

            // Catch up mid-game state
            if (g.game_started) {
                let save_packet = Packet(id.GAME_SAVE);
                self.server.broadcast(save_packet);

                let cur_player = g.cur_player;
                let is_current = cur_player == conn_id;
                let is_onevone_team = false;
                if (g.onevone && conn_id < g.num_bases) {
                    if (cur_player < half && conn_id < half) {
                        is_onevone_team = true;
                    } else if (cur_player >= half && conn_id >= half) {
                        is_onevone_team = true;
                    }
                }
                if (is_current || is_onevone_team) {
                    let endturn_packet = Packet(id.PLAYER_ENDTURN);
                    connection.broadcast(endturn_packet);
                    g.end_turn();
                }
            }

            print("Connection opened (" + conn_id + ")");
        },

        remove_connection: fn(connection) {
            let conn_id = self.get_id_from_connection(connection);

            // A connection that was never ADDED still disconnects, and get_id_from_connection
            // returns null for it -- indexing with null then throws "Index must be an integer"
            // inside the disconnect handler. That is not hypothetical: while the uid bug above
            // was kicking every client, every one of those kicks produced this second error on
            // the way out, which buried the first.
            //
            // Rejected connections are the normal case here, not an edge case: a full lobby, a
            // wrong password and a game already started all reach this path.
            if (conn_id == null) {
                print("Connection closed (never joined)");
                return;
            }

            self.connections[conn_id] = null;
            self.session.clear_connection(conn_id);

            // Handle host disconnection
            if (self.connections[self.game.host] == null) {
                let new_host = null;
                let i = 0;
                while (i < self.game.num_bases && new_host == null) {
                    if (self.connections[i] != null) {
                        new_host = i;
                    }
                    i = i + 1;
                }
                if (new_host != null) {
                    self.game.switch_host(new_host);
                } else {
                    self.kill_server(2);
                    return;
                }
            }

            if (conn_id != null) {
                print("Connection closed (" + conn_id + ")");
                let disconnect_packet = Packet(id.CLIENT_DISCONNECT);
                disconnect_packet.add(conn_id);
                self.server.broadcast(disconnect_packet);
                self.game.destroy_player_connection(conn_id);
            } else {
                print("Connection refused");
            }

            connection.kick();
        },

        swap_connections: fn(i, j, broadcast) {
            if (broadcast) {
                let swap_packet = Packet(id.PLAYER_SWAP);
                swap_packet.add(i);
                swap_packet.add(j);
                self.server.broadcast(swap_packet);
            }
            let temp = self.connections[i];
            self.connections[i] = self.connections[j];
            self.connections[j] = temp;
            self.game.swap_players(i, j);

            let pl_packet = Packet(id.PLAYER_LIST);
            self.game.add_players_to_packet(pl_packet, true);
            self.server.broadcast(pl_packet);
        },

        get_id_from_connection: fn(connection) {
            if (connection == null) { return null; }
            let i = 0;
            while (i < self.connections.length) {
                if (self.connections[i] == connection) { return i; }
                i = i + 1;
            }
            return null;
        },

        kill_server: fn(code) {
            // NAME THE CODE. Every path out of a lobby ends here and the client is told only
            // "Server closed.", so from the outside a host timeout, a heartbeat expiry, a
            // malformed upload and the 24-hour cap are indistinguishable -- and three of the
            // four look like a network fault to the player. The codes are: 0 malformed
            // upload, 1 no host connected in time, 2 last connection left, 24 max lifetime.
            print("Killing server, code " + code);
            self.session.kick_all("Server closed.");
            self.session.close();
            self.server.close();
            exit(code);
        },

        solicit_lobby_password: fn(connection) {
            let packet = Packet(id.LOBBY_PASSWORD);
            connection.send(packet);
        },

        set_one_v_one_players: fn() {
            let g = self.game;
            let half = g.num_bases / 2;

            // Move host to slot 0 or half
            let host = g.host;
            let host_slot = 0;
            if (host >= half) { host_slot = half; }
            if (host_slot != host) { self.swap_connections(host, host_slot, true); }

            // Move other player to opposite side
            let lowest_slot = null;
            let i = 0;
            while (i < g.num_bases) {
                if (i != host_slot) {
                    lowest_slot = i;
                    break;
                }
                i = i + 1;
            }
            let other_slot = half;
            if (host_slot != 0) { other_slot = 0; }
            if (lowest_slot != other_slot) { self.swap_connections(lowest_slot, other_slot, true); }

            // Move remaining connections to spectators or kick
            i = 0;
            while (i < g.num_bases) {
                if (i != host_slot && i != other_slot) {
                    let player = g.players[i];
                    if (g.spectators) {
                        self.set_player_as_spectator(i);
                    } else {
                        player.kick("Game is full.");
                    }
                    g.reset_player(i);
                }
                i = i + 1;
            }
        },

        set_player_as_spectator: fn(i) {
            let g = self.game;
            let slot = g.num_bases;
            let n = g.players.length;
            let spec_id = slot;
            let j = slot;
            while (j <= n) {
                let player = g.players[j];
                if (player == null) {
                    g.init_new_player(j);
                    spec_id = j;
                    break;
                } else if (player.connection == null) {
                    spec_id = j;
                    break;
                }
                j = j + 1;
            }
            self.swap_connections(i, spec_id, true);
        },
    };

    // Start session timers
    cm.session.start_timers(game.host, fn(reason) {
        if (reason == "host_timeout") {
            cm.kill_server(1);
        } else if (reason == "max_lifetime") {
            cm.kill_server(24);
        } else {
            // Heartbeat timeout — parse slot from "heartbeat:N"
            //
            // `number`, because split() yields STRINGS and `connections["1"]` is not
            // `connections[1]`. The reason is built by joining the index onto a label, so the
            // number survives the round trip only if it is converted back.
            let parts = reason.split(":");
            if (parts.length == 2 && parts[0] == "heartbeat") {
                let slot = number(parts[1]);
                print("Heartbeat timeout on slot " + slot);
                let conn = cm.connections[slot];
                if (conn != null) {
                    cm.remove_connection(conn);
                }
            }
        }
    });

    return cm;
}
